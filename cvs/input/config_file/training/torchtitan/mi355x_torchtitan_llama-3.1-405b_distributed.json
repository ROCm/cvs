{
  "schema_version": 1,
  "framework": "torchtitan_distributed",
  "gpu_arch": "MI355X",
  "enforce_thresholds": true,
  "loss_curve": {
    "sample_every": 10,
    "milestone_steps": [100, 500, 1000, 5000],
    "max_slope": 0.0,
    "enforce": true
  },
  "threshold_json": "mi355x_torchtitan_llama-3.1-405b_distributed_threshold.json",
  "scaling_baseline": {
    "tokens_per_sec_total": 0.0,
    "num_nodes": 1
  },
  "config": {
    "hf_token_file": "/home/{user-id}/.hf_token",
    "log_dir": "/home/{user-id}/LOGS/torchtitan",
    "scripts_dir": "/home/{user-id}/SCRIPTS/torchtitan",
    "data_cache_dir": "/home/{user-id}/cache",
    "rocm_dir": "",
    "torchtitan_root": "/workspace/torchtitan",
    "training_iterations": "10",
    "nnodes": "8",
    "nic_type": "thor2",
    "nccl_ib_hca_list": "bnxt_re0,bnxt_re1,bnxt_re2,bnxt_re3,bnxt_re4,bnxt_re5,bnxt_re6,bnxt_re7",
    "nccl_ib_hca": "bnxt_re0,bnxt_re1,bnxt_re2,bnxt_re3,bnxt_re4,bnxt_re5,bnxt_re6,bnxt_re7",
    "nccl_socket_ifname": "ensf1np1",
    "gloo_socket_ifname": "ensf1np1",
    "nccl_ib_gid_index": "3",
    "nccl_debug": "ERROR",
    "master_address": "<changeme>",
    "verify_network_errors": "False",
    "use_generated_config": "True",
    "hca_id_pattern": "bnxt_|rocep"
  },
  "model_params": {
    "model_name": "llama3_1_405b",
    "hf_model_name": "meta-llama/Llama-3.1-405B",
    "sequence_length": "8192",
    "dataset": "c4",
    "lr": "3e-4",
    "warmup_steps": "200",
    "activation_checkpointing": "selective",
    "compile": "false",
    "tensor_parallel_degree": "8",
    "pipeline_parallel_degree": "4",
    "context_parallel_degree": "1",
    "expert_parallel_degree": "1",
    "enable_async_tensor_parallel": "false",
    "precompute_float8_dynamic_scale_for_fsdp": "false",
    "data_parallel_shard_degree": "2",
    "precision": "BF16"
  },
  "container": {
    "lifetime": "per_run",
    "name": "torchtitan_llama3_1_405b_bf16_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/dev/infiniband:/dev/infiniband",
          "/usr/local/lib/libbnxt_re-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libbnxt_re-rdmav34.so.host",
          "/lib/libibverbs.d:/lib/libibverbs.d"
        ],
        "devices": [
          "/dev/kfd",
          "/dev/dri",
          "/dev/infiniband/rdma_cm"
        ]
      }
    }
  },
  "sweep": {
    "combinations": {
      "llama3_1_405b-mi355-bs8-mbs1-bf16": {
        "name": "llama3_1_405b_mbs1_gbs8_BF16",
        "global_batch_size": "8",
        "micro_batch_size": "1",
        "precision": "BF16"
      }
    },
    "runs": [
      "llama3_1_405b-mi355-bs8-mbs1-bf16"
    ]
  }
}
