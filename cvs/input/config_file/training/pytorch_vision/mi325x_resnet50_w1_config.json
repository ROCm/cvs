{
  "schema_version": 1,
  "framework": "pytorch_vision_training",
  "gpu_arch": "MI325X",
  "enforce_thresholds": true,
  "threshold_json": "mi325x_resnet50_w1_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "{shared_fs}/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "torchvision/resnet50",
    "remote": 0
  },
  "container": {
    "lifetime": "per_run",
    "name": "cvs_pytorch_vision_w1",
    "image": "rocm/pytorch:rocm7.14_ubuntu24.04_py3.12_pytorch_release_2.12.0@sha256:c38eeda81d85f00fbe35d3d50ce42ce59c524e87d810624f4eb5c52fddb3b9ad",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "volumes": [
          "/home/{user-id}:/home/{user-id}"
        ],
        "devices": [
          "/dev/kfd",
          "/dev/dri"
        ]
      }
    }
  },
  "params": {
    "nproc_per_node": 8,
    "warmup_steps": 10,
    "measure_steps": 50,
    "num_classes": 1000,
    "channels_last": true,
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "timeout_s": 1800,
    "omp_num_threads": 1,
    "verify_dmesg": true
  },
  "env": {
    "NCCL_DEBUG": "WARN",
    "HSA_NO_SCRATCH_RECLAIM": "1",
    "RCCL_USE_AMD_SMI_LIB": "1"
  },
  "sweep": {
    "combinations": {
      "w1-resnet50-bf16-bs256": {
        "name": "resnet50_bf16_bs256",
        "model": "resnet50",
        "backend": "torchvision",
        "precision": "BF16",
        "batch_size": 256,
        "image_size": 224
      }
    },
    "runs": [
      "w1-resnet50-bf16-bs256"
    ]
  }
}
