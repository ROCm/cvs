{
  "_format_note": "PyTorch Vision training config. The cluster file owns node access; this file owns the container and the training workload; the sibling *_threshold.json owns per-sweep metric gates. Run with: cvs run pytorch_vision_single|pytorch_vision_distributed --cluster_file <cluster>.json --config_file <this>.json --html <out>.html --self-contained-html",
  "schema_version": 1,
  "framework": "pytorch_vision_training",
  "gpu_name": "MI325X",
  "_thresholds_comment": "Gating is threshold-driven and requires enforce_thresholds=true. A threshold entry with kind=info always passes and records the value. Calibrate on the target filesystem and fabric before enforcing numeric limits.",
  "enforce_thresholds": true,
  "threshold_json": "mi325x_pytorch_vision_resnet50_single_to-accuracy_disabled_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "<changeme-imagenet-host-path>",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "torchvision/resnet50",
    "remote": 0
  },
  "container": {
    "lifetime": "per_run",
    "name": "cvs_pytorch_vision_w1_train_to_accuracy_disabled",
    "image": "cvs/pytorch-rocal:rocm7.2.4-py3.12-torch2.10-rocal2.5.0",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-imagenet-host-path>:/datasets/imagenet-1k:ro"
        ],
        "devices": [
          "/dev/kfd",
          "/dev/dri"
        ]
      }
    }
  },
  "_training_comment": "training{} defines the workload. `workload` is the scorecard row id (W1 ResNet-50, W3 ViT-B/16) and is cross-checked against the result artifact. `distributed` must match the suite you invoke and the cluster node count. `run_mode` selects the profile (smoke|perf|train_5k|train_to_accuracy) and determines which rows are gated. `optimizer` is sgd or adamw; transformer backbones need adamw.",
  "_sweeps_comment": "training.sweeps[] are full training runs. Each `name` is also its threshold cell key, so encode every material dimension (topology, precision, microbatch, GA, data mode, rocAL device, augmentation) to stop a result being compared against the wrong gate. `label` is the compact id used in pytest rows and log directory names. training.enabled_sweep_list selects which names execute.",
  "training": {
    "workload": "W1",
    "distributed": false,
    "enabled": false,
    "allow_long_run": false,
    "phase": "accuracy",
    "run_mode": "train_to_accuracy",
    "gpus_per_node": 8,
    "max_epochs": 90,
    "warmup_steps": 0,
    "eval_enabled": true,
    "eval_every_epochs": 1,
    "eval_sample_count": 50000,
    "milestone_steps": [
      100,
      500,
      1000,
      5000
    ],
    "num_classes": 1000,
    "channels_last": true,
    "learning_rate": 0.8,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "lr_schedule": {
      "name": "multistep",
      "warmup_epochs": 5,
      "milestones_epochs": [
        30,
        60,
        80
      ],
      "gamma": 0.1
    },
    "timeout_s": 21600,
    "omp_num_threads": 1,
    "verify_dmesg": true,
    "peak_tflops_per_gpu": 1307.4,
    "checkpoint_enabled": true,
    "checkpoint_loss_tolerance": 1e-05,
    "loss_curve": {
      "enabled": true,
      "sample_every_steps": 100,
      "minimum_points": 100,
      "require_decrease": true
    },
    "accuracy": {
      "target_top1_pct": 75.5,
      "target_top5_pct": 92.5
    },
    "convergence": {
      "enabled": true,
      "stop_when_reached": true,
      "target_top1_pct": 75.5
    },
    "codecarbon": {
      "enabled": true,
      "required": true,
      "version": "3.2.4",
      "tracker": "amdsmi",
      "measure_power_secs": 5
    },
    "env_vars": {
      "NNODES": "1",
      "NODE_RANK": "0",
      "NCCL_DEBUG": "WARN",
      "RCCL_USE_AMD_SMI_LIB": "1"
    },
    "error_patterns": {},
    "sweeps": [
      {
        "name": "W1-ACCURACY-TARGET-ROCAL-GPU-STANDARD",
        "label": "target-rocAL-GPU-standard",
        "model": "resnet50",
        "precision": "BF16",
        "batch_size": 256,
        "image_size": 224,
        "gradient_accumulation_steps": 1,
        "training_flops_per_image": 24600000000,
        "data_mode": "rocal",
        "dataset_path": "/datasets/imagenet-1k",
        "rocal_device": "gpu",
        "augmentation": "standard",
        "rocal_num_threads": 8,
        "loader_warmup_steps": 5,
        "loader_benchmark_steps": 20
      }
    ],
    "enabled_sweep_list": [
      "W1-ACCURACY-TARGET-ROCAL-GPU-STANDARD"
    ]
  }
}
