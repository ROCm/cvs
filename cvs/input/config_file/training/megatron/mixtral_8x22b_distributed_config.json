{
  "schema_version": 1,
  "framework": "megatron_distributed",
  "gpu_arch": "MI325X",
  "enforce_thresholds": false,
  "threshold_json": "mixtral_8x22b_distributed_threshold.json",
  "_scaling_baseline_comment": "1-node total tokens/sec baseline for scaling-efficiency %. Set tokens_per_sec_total=0.0 to disable. Populate from a single-node run (tok/s/GPU * 8).",
  "scaling_baseline": {
    "tokens_per_sec_total": 0.0,
    "num_nodes": 1
  },
  "config": {
    "hf_token_file": "/home/{user-id}/.hf_token",
    "log_dir": "/home/{user-id}/LOGS/megatron",
    "scripts_dir": "/home/{user-id}/SCRIPTS/megatron",
    "data_cache_dir": "/home/{user-id}/cache",
    "rocm_dir": "",
    "megatron_root": "/workspace/Megatron-LM",
    "training_iterations": "10",
    "nnodes": "<changeme>",
    "master_address": "<changeme>",
    "nic_type": "<changeme>",
    "nccl_ib_hca_list": "<changeme>",
    "nccl_ib_hca": "<changeme>",
    "nccl_socket_ifname": "<changeme>",
    "gloo_socket_ifname": "<changeme>",
    "hca_id_pattern": "bnxt_|rocep",
    "nccl_ib_gid_index": "3",
    "nccl_debug": "ERROR",
    "verify_network_errors": "True"
  },
  "model_params": {
    "model_name": "mixtral_8x22B",
    "tokenizer_model": "mistralai/Mixtral-8x22B-v0.1",
    "model_size": "8x22B",
    "sequence_length": "4096",
    "recompute": "0",
    "fsdp": "0",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "2",
    "precision": "BF16"
  },
  "container": {
    "lifetime": "per_run",
    "name": "megatron_mixtral_8x22b_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/dev/infiniband:/dev/infiniband",
          "/usr/local/lib/libbnxt_re-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libbnxt_re-rdmav34.so.host",
          "/lib/libibverbs.d:/lib/libibverbs.d"
        ],
        "devices": [
          "/dev/kfd",
          "/dev/dri",
          "/dev/infiniband/rdma_cm"
        ]
      }
    }
  },
  "sweep": {
    "combinations": {
      "mixtral_8x22b-mi325-bs64-mbs1-bf16": {
        "name": "mixtral_8x22b_mbs1_gbs64_BF16",
        "global_batch_size": "64",
        "micro_batch_size": "1",
        "precision": "BF16"
      },
      "mixtral_8x22b-mi325-bs64-mbs1-fp8": {
        "name": "mixtral_8x22b_mbs1_gbs64_FP8",
        "global_batch_size": "64",
        "micro_batch_size": "1",
        "precision": "FP8"
      }
    },
    "runs": [
      "mixtral_8x22b-mi325-bs64-mbs1-bf16",
      "mixtral_8x22b-mi325-bs64-mbs1-fp8"
    ]
  }
}
