                     "micro_batch_size": "4",
                     "precision": "TE_FP16",
                     "sequence_length": "8192",
                     "tensor_parallelism": "8",
                     "pipeline_parallelism": "1",
                     "recompute": "0",
                     "fsdp": "0",
                     "result_dict":
                     {
                         "throughput_per_gpu": "<changeme>",
