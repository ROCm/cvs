{
    "gpu_name": "mi35x",
    "no_of_nodes": "2",
    "_example_options_orchestrator": "container|baremetal",
    "orchestrator": "container",
    "container":
    {
        "image": "<changeme>",
        "name": "mori_container",
        "lifetime": "persistent",
        "runtime":
        {
            "name": "docker",
            "args":
            {
                "devices": [ "/dev/dri", "/dev/kfd" ],
                "volumes":
                [
                    "/home/{user-id}:/home/{user-id}"
                ]
            }
        }
    },
    "_example_env":
    {
        "NCCL_SOCKET_IFNAME": "eno0",
        "GLOO_SOCKET_IFNAME": "eno0",
        "MORI_RDMA_DEVICES": "rdma0,rdma1,rdma2,rdma3,rdma4,rdma5,rdma6,rdma7",
        "LD_LIBRARY_PATH": "/usr/local/lib/python3.12/dist-packages/torch/lib:$LD_LIBRARY_PATH"
    },
    "env":
    {
        "NCCL_SOCKET_IFNAME": "<changeme>",
        "GLOO_SOCKET_IFNAME": "<changeme>",
        "MORI_RDMA_DEVICES": "<changeme>",
        "LD_LIBRARY_PATH": "/usr/local/lib/python3.12/dist-packages/torch/lib:$LD_LIBRARY_PATH"
    },
    "_comment_mori_dir": "install_mori builds MoRI here and mori_benchmark_test runs it from here. Use a directory of its own, not the image's MoRI checkout.",
    "mori_dir": "/home/{user-id}/INSTALL/mori",
    "_comment_git_ref": "Tag, branch or commit of git_url that install_mori builds.",
    "git_ref": "main",
    "_comment_install_system_packages": "Lets install_mori apt-install missing build packages: inside the container, or on bare metal with passwordless sudo. Never in a Slurm or SPUR job step.",
    "install_system_packages": true,
    "master_addr": "<changeme>",
    "master_port": "1234",
    "log_dir": "/home/{user-id}/LOGS/mori",
