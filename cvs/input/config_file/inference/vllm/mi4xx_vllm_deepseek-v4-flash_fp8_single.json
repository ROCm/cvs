{
  "_comment": "vLLM single-node DeepSeek-V4-Flash baseline on MI455X: TP4 PP1, AITER on, FP8 KV cache; no MTP, no TunableOp, stock RCCL. Set paths.shared_fs and server_params.model before running.",
  "enforce_thresholds": true,
  "threshold_json": "mi455x_vllm_deepseek-v4-flash_fp8_single_threshold.json",
  "paths": {
    "_comment": "Host and container paths for model access, artifacts, and Hugging Face authentication.",
    "shared_fs": "<changeme>",
    "models_dir": "{shared_fs}/hf_cache",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "_comment": "Container definition and static environment inherited by server and benchmark commands.",
    "lifetime": "per_run",
    "name": "vllm_deepseek-v4-flash_fp8_single_mi455x",
    "image": "rocm/vllm-dev:nightly_455_wip__torch__1002_b296",
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "HIP_VISIBLE_DEVICES": "0,1,2,3",
      "OMP_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "NUMEXPR_NUM_THREADS": "1",
      "VECLIB_MAXIMUM_THREADS": "1",
      "VLLM_ENGINE_READY_TIMEOUT_S": "1800",
      "HSA_DISABLE_COREDUMP_ON_EXCEPTION": "1",
      "PYTHONFAULTHANDLER": "1",
      "VLLM_LOG_STATS_INTERVAL": "5",
      "VLLM_PORT": "40000",
      "NCCL_DEBUG": "INFO",
      "NCCL_DEBUG_SUBSYS": "INIT,GRAPH,ENV",
      "NCCL_DEBUG_FILE": "{paths.log_dir}/rccl.%h.%p.log",
      "NCCL_TOPO_DUMP_FILE": "{paths.log_dir}/rccl-topo.xml",
      "VLLM_CACHE_ROOT": "{paths.shared_fs}/cache/vllm",
      "AITER_JIT_DIR": "{paths.shared_fs}/cache/aiter-jit",
      "TRITON_CACHE_DIR": "{paths.shared_fs}/cache/triton",
      "XDG_CACHE_HOME": "{paths.shared_fs}/cache/xdg"
    },
    "runtime": {
      "name": "docker",
      "args": {
        "_comment_bnxt_mount": "Broadcom Thor2 (bnxt_re). Bind-mounts host /usr/local/lib/libbnxt_re-rdmav34.so read-only onto the container libibverbs provider path. Delete this entry when the nodes have no Thor2 library; docker run fails if the host path is missing.",
        "_comment_ionic_mounts": "AMD Pensando Ionic / AINIC. Bind-mounts libionic.so, libionic.so.1, the versioned libionic.so.1.* soname, libibverbs/libionic-rdmav34.so, and /etc/libibverbs.d/ionic.driver. Replace its <changeme> entry with the versioned soname from readlink -f /usr/lib/x86_64-linux-gnu/libionic.so.1, as _volumes_example shows. Delete these entries when the nodes have no Ionic stack; docker run fails if a host path is missing.",
        "volumes": [
          "{paths.shared_fs}:{paths.shared_fs}",
          "/usr/local/lib/libbnxt_re-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libbnxt_re-rdmav34.so:ro",
          "<changeme>",
          "/usr/lib/x86_64-linux-gnu/libionic.so.1:/usr/lib/x86_64-linux-gnu/libionic.so.1:ro",
          "/usr/lib/x86_64-linux-gnu/libionic.so:/usr/lib/x86_64-linux-gnu/libionic.so:ro",
          "/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:ro",
          "/etc/libibverbs.d/ionic.driver:/etc/libibverbs.d/ionic.driver:ro"
        ],
        "_volumes_example": [
          "/usr/lib/x86_64-linux-gnu/libionic.so.1.<version>:/usr/lib/x86_64-linux-gnu/libionic.so.1.<version>:ro"
        ]
      }
    }
  },
  "server_params": {
    "_comment": "Shared server fields; every other vllm serve option goes in engine_args, in snake_case.",
    "model": "<changeme>",
    "tp": 4,
    "port": 8947,
    "master_port": 28947,
    "max_model_length": 20480,
    "engine_args": {
      "trust_remote_code": true,
      "kv_cache_dtype": "fp8",
      "gpu_memory_utilization": 0.9,
      "max_num_seqs": 256,
      "no_enable_prefix_caching": true
    }
  },
  "benchmark_params": {
    "_comment": "Default vllm bench serve settings; client_args holds other client options in snake_case, and per-cell values in sweeps override these defaults.",
    "num_prompts": 750,
    "random_range_ratio": 0.0,
    "seed": 1234,
    "request_rate": "inf",
    "client_args": {
      "trust_remote_code": true,
      "temperature": 0
    }
  },
  "timeouts": {
    "_comment": "Seconds from launch to a ready server, and for one cell's client run.",
    "server_ready_s": 2430,
    "client_s": 3620
  },
  "_comment_sweeps": "Canonical run cells; entries override benchmark_params for that cell.",
  "sweeps": {
    "ISL=1024,OSL=256,TP=4,PP=1,CONC=64": {},
    "ISL=16384,OSL=128,TP=4,PP=1,CONC=4": {},
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=16": {},
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=64": {},
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=32": {}
  },
  "_comment_runs": "Explicit ordered run cells to execute.",
  "runs": [
    "ISL=1024,OSL=256,TP=4,PP=1,CONC=64",
    "ISL=16384,OSL=128,TP=4,PP=1,CONC=4",
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=16",
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32",
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=64",
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=32"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "gsm8k_strict",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "strict-match"
          }
        },
        {
          "id": "gsm8k_stderr",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "flexible-extract"
          }
        }
      ]
    }
  }
}
