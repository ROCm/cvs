{
  "_comment": "SGLang single-node DeepSeek-R1-0528 workload. Performance cells are defined by threshold_json.",
  "schema_version": 1,
  "framework": "sglang",
  "topology": "single",
  "threshold_json": "mi3xx_sglang_deepseek_r1_0528_threshold.json",
  "_container_image": "rocm/sgl-dev:v0.5.12.post1-rocm720-mi30x-20260601",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/root/models",
    "log_dir": "{shared_fs}/LOGS/sglang",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "/root/models/DeepSeek-R1-0528",
    "remote": 0
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_container",
    "image": "rocm/sgl-dev:v0.5.12.post1-rocm720-mi30x-20260603",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/mnt/dtni/models:/root/models"
        ],
        "devices": ["/dev/dri", "/dev/kfd"],
        "env": {}
      }
    }
  },
  "roles": {
    "server": {
      "nnodes": "1",
      "log_level": "info",
      "nccl_debug": "ERROR",
      "benchmark_serv_node": "<changeme>",
      "proxy_router_serv_port": "8000"
    }
  },
  "params": {
    "backend": "sglang",
    "max_concurrency": "256",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "1",
    "memory_fraction": "0.7",
    "tokenizer_mode": "auto",
    "inference_poll_iterations": "16",
    "add_export_env": ["SGLANG_USE_AITER=1", "AMDGCN_USE_BUFFER_OPS=1", "ROCM_QUICK_REDUCE_QUANTIZATION=INT8", "GPU_ARCHS=gfx942"],
    "add_flags": ["--attention-backend aiter"],
    "inference_tests": {
      "bench_serv_random": {
        "backend": "sglang",
        "enforce_thresholds": false,
        "data_set_name": "random",
        "num_prompts": "25",
        "random_range_ratio": "0.5",
        "model_num_params": "671000000000",
        "peak_gpu_tflops": "2615"
      }
    }
  },
  "accuracy": {
    "tasks": [
      {
        "id": "lm_eval_hellaswag",
        "backend": "sglang",
        "lm_eval_model": "local-completions",
        "tasks": "hellaswag",
        "num_fewshot": "0",
        "batch_size": "auto",
        "limit": "100",
        "num_concurrent": "1",
        "exec_timeout_sec": "7200",
        "extra_model_args": "tokenizer_backend=huggingface"
      },
      {
        "id": "lm_eval_gsm8k",
        "backend": "sglang",
        "lm_eval_model": "local-completions",
        "tasks": "gsm8k",
        "num_fewshot": "5",
        "batch_size": "auto",
        "limit": "100",
        "num_concurrent": "4",
        "exec_timeout_sec": "7200",
        "extra_model_args": "tokenizer_backend=huggingface"
      }
    ]
  }
}
