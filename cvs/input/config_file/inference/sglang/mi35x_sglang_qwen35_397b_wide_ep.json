{
    "_comment": "SGLang wide expert-parallel Qwen3.5-397B-A17B-FP8 workload. Two nodes, TP=EP=16, attention DP=16, PP=1. The all-to-all backend is an add_flags entry. Reuses the MI355 Qwen threshold file; enforce_thresholds stays false until wide-EP bars are measured.",
    "topology": "wide_ep",
    "enforce_thresholds": false,
    "gpu_name" : "<changeme> mi355",
    "threshold_json": "mi355_sglang_qwen35_397b_threshold.json",
    "paths": {
      "shared_fs": "/home/{user-id}",
      "models_dir": "/root/models",
      "log_dir": "{shared_fs}/LOGS/sglang",
      "hf_token_file": "{shared_fs}/.hf_token"
    },
    "container": {
      "lifetime": "per_run",
      "name": "sglang_container",
      "_image_example": "rocm/sgl-dev:v0.5.20-rocm720-mi35x-20260924",
      "image": "<changeme>",
      "runtime": {
        "name": "docker",
        "args": {
          "network": "host",
          "ipc": "host",
          "privileged": true,
          "shm_size": "128G",
          "volumes": [
            "/home/{user-id}:/home/{user-id}",
            "/mnt/dtni/models:/root/models",
            "/dev/infiniband:/dev/infiniband",
            "/usr/lib/x86_64-linux-gnu/libionic.so.1:/usr/lib/x86_64-linux-gnu/libionic.so.1:ro",
            "/usr/lib/x86_64-linux-gnu/libionic.so:/usr/lib/x86_64-linux-gnu/libionic.so:ro",
            "/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:ro",
            "/etc/libibverbs.d/ionic.driver:/etc/libibverbs.d/ionic.driver:ro"
          ],
          "devices": ["/dev/dri", "/dev/kfd", "/dev/infiniband/rdma_cm"],
          "env": {
            "NCCL_IB_HCA": "<changeme> ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7",
            "NCCL_SOCKET_IFNAME": "<changeme> ens3",
            "GLOO_SOCKET_IFNAME": "<changeme> ens3",
            "GLOO_TCP_IFNAME": "<changeme> ens3",
            "NCCL_IB_GID_INDEX": "<changeme> 1",
            "NCCL_MAX_NCHANNELS": "<changeme> 32",
            "NCCL_MIN_NCHANNELS": "<changeme> 32",
            "NCCL_DMABUF_ENABLE": "1",
            "NCCL_DEBUG": "INFO",
            "SGLANG_USE_AITER": "1",
            "NCCL_IB_PCI_RELAXED_ORDERING": "0",
            "NCCL_DEBUG_SUBSYS": "INIT,NET"
          }
        }
      }
    },
    "server_params": {
      "serve_port": "8010",
      "backend": "sglang",
      "nnodes": "2",
      "log_level": "info",
      "model": "<changeme> /root/models/Qwen3.5-397B-A17B-FP8",
      "max_concurrency": "256",
      "tensor_parallelism": "16",
      "pipeline_parallelism": "1",
      "expert_parallelism": "16",
      "attn_data_parallelism": "16",
      "deepep_mode": "normal",
      "memory_fraction": "0.7",
      "tokenizer_mode": "auto",
      "inference_poll_iterations": "16",
      "context_length": "205000",
      "add_flags":  ["--attention-backend aiter", "--disable-custom-all-reduce", "--moe-a2a-backend mori"]
    },
    "benchmark_params": {
          "backend": "sglang",
          "data_set_name": "random",
          "num_prompts": "25",
          "random_range_ratio": "0.5",
          "model_num_params": "17000000000",
          "peak_gpu_tflops": "2615"
    },
    "accuracy": {
      "tasks": [
        {
          "id": "lm_eval_hellaswag",
          "backend": "sglang",
          "lm_eval_model": "local-completions",
          "tasks": "hellaswag",
          "num_fewshot": "0",
          "batch_size": "auto",
          "limit": "100",
          "num_concurrent": "1",
          "exec_timeout_sec": "7200",
          "extra_model_args": "tokenizer_backend=huggingface"
        },
        {
          "id": "lm_eval_gsm8k",
          "backend": "sglang",
          "lm_eval_model": "local-completions",
          "tasks": "gsm8k",
          "num_fewshot": "5",
          "batch_size": "auto",
          "limit": "100",
          "num_concurrent": "4",
          "exec_timeout_sec": "7200",
          "extra_model_args": "tokenizer_backend=huggingface"
        }
      ]
    },
  "sweeps": {
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=4": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=8": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=16": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=32": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=64": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=128": {},
      "ISL=1024,OSL=1024,TP=16,PP=1,CONC=256": {},
      "ISL=8192,OSL=1024,TP=16,PP=1,CONC=64": {}
  },
  "sweep": {
      "_comment": "Combo-key runs of ISL, OSL, TP, PP, and CONC, comma-separated. TP/PP label the cell and do not relaunch the server. Each listed run must match a threshold cell. If this field is empty, every run in the threshold JSON is used.",
      "runs": [
        {
          "combo": "ISL=1024,OSL=1024,TP=16,PP=1,CONC=64"
        },
        {
          "combo": "ISL=1024,OSL=1024,TP=16,PP=1,CONC=128"
        }
      ]
  }
}
