{
  "_comment": "SGLang single-node DeepSeek-R1-0528 workload. Performance cells are defined by threshold_json.",
  "enforce_thresholds": false,
  "threshold_json": "mi355_sglang_deepseek_r1_0528_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/root/models",
    "log_dir": "{shared_fs}/LOGS/sglang",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_container",
    "_image_example": "rocm/sgl-dev:v0.5.20-rocm720-mi35x-20260924",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": ["/home/{user-id}:/home/{user-id}", "/mnt/dtni/models:/root/models"],
        "devices": ["/dev/dri", "/dev/kfd"]
      }
    },
    "env": {"NCCL_DEBUG": "ERROR", "SGLANG_USE_AITER": "1", "AMDGCN_USE_BUFFER_OPS": "1"}
  },
  "server_params": {
    "model": "<changeme> /root/models/DeepSeek-R1-0528",
    "tp": 8,
    "pp": 1,
    "nnodes": 1,
    "port": 8000,
    "master_port": 40001,
    "engine_args": {"attention_backend": "aiter", "log_level": "info", "mem_fraction_static": 0.7}
  },
  "benchmark_params": {"num_prompts": 25, "random_range_ratio": 0.5},
  "timeouts": {"client_s": 1500},
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=4": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=8": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=16": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
    "ISL=8192,OSL=1024,TP=8,PP=1,CONC=64": {}
  },
  "runs": ["ISL=1024,OSL=1024,TP=8,PP=1,CONC=64", "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128"],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "lm_eval_hellaswag",
          "lm_eval_model": "local-completions",
          "tasks": "hellaswag",
          "num_fewshot": 0,
          "batch_size": "auto",
          "limit": 100,
          "num_concurrent": 1,
          "exec_timeout_sec": 7200,
          "extra_model_args": "tokenizer_backend=huggingface"
        },
        {
          "id": "lm_eval_gsm8k",
          "lm_eval_model": "local-completions",
          "tasks": "gsm8k",
          "num_fewshot": 5,
          "batch_size": "auto",
          "limit": 100,
          "num_concurrent": 4,
          "exec_timeout_sec": 7200,
          "extra_model_args": "tokenizer_backend=huggingface"
        }
      ]
    }
  }
}
