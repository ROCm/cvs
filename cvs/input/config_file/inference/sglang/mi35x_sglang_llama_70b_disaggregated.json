{
  "_comment": "SGLang disaggregated Llama 3.1 70B workload with cache-aware prefill and decode routing.",
  "enforce_thresholds": false,
  "threshold_json": "mi355_sglang_llama_70b_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/root/models",
    "log_dir": "{shared_fs}/LOGS/sglang",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_container",
    "_image_example": "rocm/sgl-dev:v0.5.20-rocm720-mi35x-20260924",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/mnt/dtni/models:/root/models",
          "/dev/infiniband:/dev/infiniband",
          "/usr/lib/x86_64-linux-gnu/libionic.so.1:/usr/lib/x86_64-linux-gnu/libionic.so.1:ro",
          "/usr/lib/x86_64-linux-gnu/libionic.so:/usr/lib/x86_64-linux-gnu/libionic.so:ro",
          "/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:ro",
          "/etc/libibverbs.d/ionic.driver:/etc/libibverbs.d/ionic.driver:ro"
        ],
        "devices": ["/dev/dri", "/dev/kfd", "/dev/infiniband"]
      }
    },
    "env": {
      "NCCL_IB_HCA": "<changeme> ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7",
      "NCCL_SOCKET_IFNAME": "<changeme> ens3",
      "GLOO_SOCKET_IFNAME": "<changeme> ens3",
      "GLOO_TCP_IFNAME": "<changeme> ens3",
      "NCCL_IB_GID_INDEX": "<changeme> 1",
      "NCCL_MAX_NCHANNELS": "<changeme> 32",
      "NCCL_MIN_NCHANNELS": "<changeme> 32",
      "NCCL_DMABUF_ENABLE": "0",
      "NCCL_DEBUG": "INFO",
      "MC_GID_INDEX": "<changeme> 1",
      "MC_DISABLE_HIP": "1",
      "HSA_FORCE_FINE_GRAIN_PCIE": "0",
      "NCCL_IB_PCI_RELAXED_ORDERING": "0",
      "NCCL_DEBUG_SUBSYS": "INIT,NET",
      "SGLANG_USE_AITER": "1"
    }
  },
  "server_params": {
    "model": "<changeme> meta-llama/Llama-3.1-70B-Instruct",
    "tp": 8,
    "pp": 1,
    "nnodes": 2,
    "port": 8010,
    "master_port": 40001,
    "engine_args": {
      "attention_backend": "aiter",
      "disable_custom_all_reduce": true,
      "disable_overlap_schedule": true,
      "log_level": "info",
      "mem_fraction_static": 0.85
    }
  },
  "benchmark_params": {"num_prompts": 100, "random_range_ratio": 0.5},
  "timeouts": {"client_s": 1500},
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=4": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=8": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=16": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
    "ISL=8192,OSL=1024,TP=8,PP=1,CONC=64": {}
  },
  "runs": ["ISL=1024,OSL=1024,TP=8,PP=1,CONC=64", "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128"],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "lm_eval_hellaswag",
          "lm_eval_model": "local-completions",
          "tasks": "hellaswag",
          "num_fewshot": 0,
          "batch_size": "auto",
          "limit": 100,
          "num_concurrent": 1,
          "exec_timeout_sec": 7200,
          "extra_model_args": "tokenizer_backend=huggingface"
        },
        {
          "id": "lm_eval_gsm8k",
          "lm_eval_model": "local-completions",
          "tasks": "gsm8k",
          "num_fewshot": 5,
          "batch_size": "auto",
          "limit": 100,
          "num_concurrent": 4,
          "exec_timeout_sec": 7200,
          "extra_model_args": "tokenizer_backend=huggingface"
        }
      ]
    }
  }
}
