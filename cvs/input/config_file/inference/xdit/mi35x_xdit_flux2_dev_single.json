{
    "_comment": "FLUX.2-dev single-node xDiT workload. Bind-mounts flux2_example.py when the image does not ship it. Download model before run.",
    "gpu_name" : "<changeme> mi355",
    "enforce_thresholds": true,
    "threshold_json": "xdit_flux2_dev_single_threshold.json",
    "paths": {
      "shared_fs": "{home}",
      "models_dir": "{home}/.cache/huggingface",
      "log_dir": "{home}/cvs_flux2_output",
      "hf_token_file": "{home}/.hf_token"
    },
    "container": {
      "lifetime": "per_run",
      "name": "flux2-benchmark_single",
      "_image_example": "rocm/ufb-private:xdit-gfx950-py3.12-prereleases-rocm10.1.0rc3-6b5b35c",
      "image": "<changeme>",
      "runtime": {
        "name": "docker",
        "args": {
          "network": "host",
          "ipc": "host",
          "privileged": true,
          "shm_size": "128G",
          "volumes": [
            "{paths.models_dir}:/hf_home",
            "{paths.log_dir}:/outputs",
            "{home}/cvs/cvs/lib/inference/xdit/scripts/flux2_example.py:/benchmark/flux2_example.py"
          ],
          "devices": ["/dev/dri", "/dev/kfd"],
          "env": {
            "NCCL_DEBUG": "ERROR"
          }
        }
      }
    },
    "server_params": {
      "backend": "xdit",
      "nnodes": "1",
      "log_level": "info",
      "model": "<changeme> /shared_nfs/xdit/FLUX.2-dev"
    },
    "benchmark_params": {
      "model_type": "flux2",
      "guidance_scale": 4.0,
      "prompt": "A small cat",
      "seed": 42,
      "num_inference_steps": 50,
      "max_sequence_length": 512,
      "no_use_resolution_binning": true,
      "warmup_steps": 1,
      "warmup_calls": 5,
      "num_repetitions": 25,
      "height": 1024,
      "width": 1024,
      "ulysses_degree": 8,
      "ring_degree": 1,
      "use_torch_compile": true,
      "torchrun_nproc": 8
    }
  }
