{
    "_comment": "FLUX.1-dev distributed xDiT workload. Replace every <changeme> NCCL/network field before running.",
    "gpu_name" : "<changeme> mi355",
    "enforce_thresholds": true,
    "threshold_json": "mi325_xdit_flux1_dev_distributed_threshold.json",
    "paths": {
      "shared_fs": "/home/{user-id}",
      "models_dir": "/home/{user-id}",
      "log_dir": "{home}/cvs_flux1_output",
      "hf_token_file": "/home/{user-id}/.hf_token"
    },
    "container": {
      "lifetime": "per_run",
      "name": "flux-benchmark_distributed",
      "_image_example": "amdsiloai/pytorch-xdit:v25.11.2",
      "image": "<changeme>",
      "runtime": {
        "name": "docker",
        "args": {
          "network": "host",
          "ipc": "host",
          "privileged": true,
          "shm_size": "128G",
          "volumes": [
            "/home/{user-id}:/home/{user-id}",
            "{paths.models_dir}:/hf_home",
            "{paths.log_dir}:/outputs",
            "/dev/infiniband:/dev/infiniband",
            "/usr/lib/x86_64-linux-gnu/libionic.so.1.0.54.0-149.g3304be71:/usr/lib/x86_64-linux-gnu/libionic.so.1.0.54.0-149.g3304be71:ro",
            "/usr/lib/x86_64-linux-gnu/libionic.so.1:/usr/lib/x86_64-linux-gnu/libionic.so.1:ro",
            "/usr/lib/x86_64-linux-gnu/libionic.so:/usr/lib/x86_64-linux-gnu/libionic.so:ro",
            "/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:ro",
            "/etc/libibverbs.d/ionic.driver:/etc/libibverbs.d/ionic.driver:ro"
          ],
          "devices": ["/dev/dri", "/dev/kfd", "/dev/infiniband"],
          "env": {
            "NCCL_PROTO": "Simple",
            "NCCL_IB_HCA": "ionic_0,ionic_1,ionic_2,ionic_3",
            "NCCL_SOCKET_IFNAME": "ens3",
            "GLOO_SOCKET_IFNAME": "ens3",
            "GLOO_TCP_IFNAME": "ens3",
            "NCCL_IB_GID_INDEX": "1",
            "NCCL_DMABUF_ENABLE": "0",
            "NCCL_DEBUG": "INFO",
            "NCCL_IB_PCI_RELAXED_ORDERING": "0",
            "HIP_VISIBLE_DEVICES": "0,1,2,3",
            "CUDA_VISIBLE_DEVICES": "0,1,2,3",
            "NCCL_DEBUG_SUBSYS": "INIT,NET"
          }
        }
      }
    },
    "server_params": {
      "backend": "xdit",
      "nnodes": "2",
      "log_level": "info",
      "model": "<changeme>"
    },
    "benchmark_params": {
      "prompt": "A small cat",
      "seed": 42,
      "num_inference_steps": 25,
      "max_sequence_length": 256,
      "no_use_resolution_binning": true,
      "warmup_steps": 1,
      "warmup_calls": 5,
      "num_repetitions": 25,
      "height": 1024,
      "width": 1024,
      "ulysses_degree": 8,
      "ring_degree": 2,
      "use_torch_compile": false,
      "torchrun_nproc": 8
    }
  }
  