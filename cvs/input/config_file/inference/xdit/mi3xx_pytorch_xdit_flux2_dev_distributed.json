{
  "_comment": "FLUX.2-dev distributed xDiT workload. Replace every <changeme> NCCL/network field before running.",
  "schema_version": 1,
  "framework": "xdit",
  "gpu_arch": "mi3xx",
  "topology": "distributed",
  "enforce_thresholds": true,
  "threshold_json": "mi3xx_pytorch_xdit_flux2_dev_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/{user-id}/.cache/huggingface",
    "log_dir": "/home/{user-id}/cvs_flux_output",
    "hf_token_file": "/home/{user-id}/.hf_token"
  },
  "model": {
    "id": "black-forest-labs/FLUX.2-dev",
    "remote": 0
  },
  "container": {
    "lifetime": "per_run",
    "name": "flux-benchmark-dist",
    "_image_example": "rocm/ufb-private:xdit-gfx942-py3.12-prereleases-rocm10.0.0rc3-2805c93",
    "image": "<changeme>",
    "env": {
      "NCCL_PROTO": "Simple"
    },
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "cap_add": ["SYS_PTRACE"],
        "security_opt": ["seccomp=unconfined"],
        "devices": ["/dev/dri", "/dev/kfd"],
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "{paths.models_dir}:/hf_home",
          "{paths.log_dir}:/outputs",
          "/home/{user-id}/cvs/cvs/lib/inference/xdit/scripts/flux2_example.py:/benchmark/flux2_example.py"
        ]
      }
    }
  },
  "nnodes": 2,
  "master_addr": "<changeme>",
  "master_port": 29500,
  "_example_nccl_ib_hca": "rdma0,rdma1,rdma2,rdma3,rdma4,rdma5,rdma6,rdma7",
  "nccl_ib_hca": "<changeme>",
  "_example_nccl_socket_ifname": "eno0",
  "nccl_socket_ifname": "<changeme>",
  "_example_gloo_socket_ifname": "eno0",
  "gloo_socket_ifname": "<changeme>",
  "nccl_ib_gid_index": 3,
  "nccl_debug": "INFO",
  "params": {
    "flux1_dev_t2i": {
      "model_type": "flux2",
      "guidance_scale": 4.0,
      "prompt": "A small cat",
      "seed": 42,
      "num_inference_steps": 50,
      "max_sequence_length": 512,
      "no_use_resolution_binning": true,
      "warmup_steps": 1,
      "warmup_calls": 5,
      "num_repetitions": 25,
      "height": 1024,
      "width": 1024,
      "ulysses_degree": 8,
      "ring_degree": 2,
      "use_torch_compile": true,
      "torchrun_nproc": 8
    }
  }
}
