{
    "_comment": "WAN 2.1 T2V Diffusers xFuser distributed workload. server_params.model is a Hugging Face repo id or an absolute host path. Replace every <changeme> NCCL/network field before running. Download model before run.",
    "gpu_name" : "<changeme> mi355",
    "enforce_thresholds": true,
    "threshold_json": "xdit_wan21_t2v_14b_diffusers_distributed_threshold.json",
    "paths": {
      "shared_fs": "/home/{user-id}",
      "models_dir": "<changeme> /data/models",
      "log_dir": "{home}/cvs_outputs_wan21_t2v",
      "hf_token_file": "/home/{user-id}/.hf_token"
    },
    "container": {
      "lifetime": "per_run",
      "name": "wan21-t2v-benchmark_diffusers_distributed",
      "_image_example": "rocm/pytorch-xdit:v26.9",
      "_image_comment": "The image needs xfuser.runner support for Wan2.1-T2V.",
      "image": "<changeme>",
      "runtime": {
        "name": "docker",
        "args": {
          "network": "host",
          "ipc": "host",
          "privileged": true,
          "shm_size": "128G",
          "volumes": [
            "/home/{user-id}:/home/{user-id}",
            "{paths.models_dir}:/hf_home",
            "{paths.log_dir}:/outputs",
            "/home/{user-id}/cvs/cvs/lib/inference/xdit/scripts/wan_t2v_example.py:/benchmark/wan_t2v_example.py",
            "/home/{user-id}/cvs/cvs/lib/inference/xdit/scripts/fid_sweep.py:/benchmark/fid_sweep.py",
            "/dev/infiniband:/dev/infiniband",
            "/usr/lib/x86_64-linux-gnu/libionic.so.1:/usr/lib/x86_64-linux-gnu/libionic.so.1:ro",
            "/usr/lib/x86_64-linux-gnu/libionic.so:/usr/lib/x86_64-linux-gnu/libionic.so:ro",
            "/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:/usr/lib/x86_64-linux-gnu/libibverbs/libionic-rdmav34.so:ro",
            "/etc/libibverbs.d/ionic.driver:/etc/libibverbs.d/ionic.driver:ro"
          ],
          "devices": ["/dev/dri", "/dev/kfd", "/dev/infiniband"],
          "env": {
            "NCCL_PROTO": "Simple",
            "NCCL_IB_HCA": "<changeme> ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7",
            "NCCL_SOCKET_IFNAME": "<changeme> ens3",
            "GLOO_SOCKET_IFNAME": "<changeme> ens3",
            "GLOO_TCP_IFNAME": "<changeme> ens3",
            "NCCL_IB_GID_INDEX": "<changeme> 1",
            "NCCL_DMABUF_ENABLE": "0",
            "NCCL_DEBUG": "ERROR",
            "NCCL_IB_PCI_RELAXED_ORDERING": "0"
          }
        }
      }
    },
    "server_params": {
      "backend": "xdit",
      "nnodes": "2",
      "log_level": "info",
      "model": "<changeme> /data/models/Wan2.1-T2V-14B-Diffusers"
    },
    "benchmark_params": {
      "model_format": "diffusers",
      "clip_model": "/hf_home/clip-vit-base-patch32",
      "wan_diffusers_launcher": "xfuser_example",
      "wan_diffusers_run_script": "/benchmark/wan_t2v_example.py",
      "wan_xfuser_model": "Wan2.1-T2V",
      "wan_xfuser_auto_input_image": false,
      "wan_xfuser_install_video_deps": true,
      "wan_xfuser_output_type": "pil",
      "require_video_artifact": true,
      "attention_backend": "AITER",
      "cross_attention_backend": "AITER",
      "guidance_scale": 6.0,
      "flow_shift": 8.0,
      "seed": 0,
      "wan_diffusers_video_fps": 16,
      "prompt": "A stylish woman walks down a Tokyo street filled with warm glowing neon and animated city signage. She wears a black leather jacket, a long red dress, and black boots, and carries a black purse. She wears sunglasses and red lipstick. She walks confidently and casually. The street is damp and reflective, creating a mirror effect of the colorful lights. Many pedestrians walk about.",
      "size": "480*832",
      "frame_num": 81,
      "num_benchmark_steps": 1,
      "num_inference_steps": 30,
      "fid_nfe_steps": [10, 30],
      "fid_reference_dir": "/hf_home/fid_reference",
      "fid_inception_path": "/hf_home/inception_v3.pth",
      "warmup_steps": 1,
      "compile": false,
      "torchrun_nproc": 8,
      "ulysses_size": 8,
      "ring_size": 2
    }
  }
