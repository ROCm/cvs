{
  "_comment": "GPT-OSS-120B vLLM distributed pair for the shipped TP4 single stem. The current vLLM recipe example is TP1. Bring-up thresholds. Distributed PP=2.",
  "gpu_arch": "mi3xx",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_vllm_gpt-oss-120b_mxfp4_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "openai/gpt-oss-120b",
    "remote": 0,
    "precision": "mxfp4"
  },
  "container": {
    "lifetime": "per_run",
    "name": "vllm_mi3xx_gptoss_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro",
          "/dev/infiniband:/dev/infiniband"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd",
          "/dev/infiniband/rdma_cm"
        ]
      }
    }
  },
  "server_params": {
    "backend": "vllm_atom",
    "nnodes": "2",
    "model": "openai/gpt-oss-120b",
    "tensor_parallelism": "4",
    "pipeline_parallelism": "2",
    "port_no": "8000",
    "serve_args": {
      "trust-remote-code": true,
      "enforce-eager": true,
      "gpu-memory-utilization": "0.95",
      "block-size": 64,
      "no-enable-prefix-caching": true
    },
    "master_addr": "{head-node-ip}",
    "master_port": "29501",
    "ib_hca_devices": "auto",
    "ib_netdev": "auto",
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "AMDGCN_USE_BUFFER_OPS": "0",
      "ATOM_USE_TRITON_MOE": "1",
      "ATOM_USE_TRITON_GEMM": "1",
      "NCCL_IB_GID_INDEX": "3",
      "NCCL_DEBUG": "ERROR"
    }
  },
  "benchmark_params": {
    "backend": "vllm",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "max_model_length": "12288",
    "metric_percentiles": "95,99",
    "client_poll_count": "150",
    "client_poll_wait_time": "60",
    "reuse_server_across_sweep": "true"
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=4,PP=2,CONC=32": {},
    "ISL=1024,OSL=1024,TP=4,PP=2,CONC=64": {},
    "ISL=128,OSL=32,TP=4,PP=2,CONC=1": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      }
    ]
  }
}
