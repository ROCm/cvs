        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "M4 framework parity: driver=sglang single-node"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx_sglang",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
