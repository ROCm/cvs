{
  "schema_version": 2,
  "framework": "atom",
  "default_profile": "perf",
  "threshold_json": "mi325x_atom_deepseek-r1_fp8_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-R1-0528",
    "remote": 0,
    "precision": "fp8"
  },
  "profiles": {
    "perf": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "<changeme>",
        "notes": "DeepSeek-R1-0528 FP8 single-node: atom driver perf gate (1K/1K) plus accuracy"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "<changeme-models-mount>:/models:ro"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--kv_cache_dtype",
            "fp8",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "random_range_ratio": "0.8",
        "num_prompts": "1000",
        "max_model_length": "4096",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "platform": {
        "gpu_metrics_poll": true
      },
      "sweeps": {
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
        "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
      },
      "runs": [],
      "quant_parity": {
        "enabled": true,
        "probe_prompt": "The capital of France is",
        "reference_config_stem": ""
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4
          },
          {
            "id": "gsm8k_strict",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4,
            "metadata": {
              "filter": "strict-match"
            }
          },
          {
            "id": "gsm8k_stderr",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4,
            "metadata": {
              "filter": "flexible-extract"
            }
          },
          {
            "id": "hellaswag",
            "task": "hellaswag",
            "num_fewshot": 0,
            "num_concurrent": 4
          },
          {
            "id": "mmlu_pro",
            "task": "mmlu_pro",
            "num_fewshot": 5,
            "num_concurrent": 4
          },
          {
            "id": "bbh",
            "task": "bbh",
            "num_fewshot": 3,
            "num_concurrent": 4
          },
          {
            "id": "musr",
            "task": "musr",
            "num_fewshot": 0,
            "num_concurrent": 4
          },
          {
            "id": "arc_challenge",
            "task": "arc_challenge",
            "num_fewshot": 0,
            "num_concurrent": 4
          },
          {
            "id": "winogrande",
            "task": "winogrande",
            "num_fewshot": 0,
            "num_concurrent": 4
          }
        ]
      }
    },
    "mtp3": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "<changeme>",
        "notes": "DeepSeek-R1-0528 FP8 single-node MTP-3 speculative decode perf and gsm8k quality"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "<changeme-models-mount>:/models:ro"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--kv_cache_dtype",
            "fp8",
            "--trust-remote-code",
            "--method",
            "mtp",
            "--num-speculative-tokens",
            "3"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "random_range_ratio": "0.8",
        "num_prompts": "1000",
        "max_model_length": "4096",
        "metric_percentiles": "95,99",
        "bench_extra_args": "--use-chat-template",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "mtp_quality": {
        "enabled": true,
        "chat_template_prompt": "Briefly introduce yourself in one sentence.",
        "chat_template_expected_sha256": ""
      },
      "sweeps": {
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
        "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
      },
      "runs": [],
      "platform": {
        "gpu_metrics_poll": true
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4,
            "apply_chat_template": true
          },
          {
            "id": "gsm8k_strict",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4,
            "apply_chat_template": true,
            "metadata": {
              "filter": "strict-match"
            }
          }
        ]
      }
    }
  }
}
