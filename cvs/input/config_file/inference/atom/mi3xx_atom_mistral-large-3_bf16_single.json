{
  "_comment": "P2 smoke probe for it-share Mistral-Large-3-BF16. No --block-size until ATOM asserts it. Do not run a full perf sweep until smoke /health is green.",
  "schema_version": 1,
  "framework": "atom",
  "threshold_json": "mi325x_atom_mistral-large-3_bf16_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "/models/Mistral-Large-3-BF16",
    "remote": 0,
    "precision": "bf16"
  },
  "enforce_thresholds": false,
  "run_card": {
    "atom_image_pin": "<changeme>",
    "notes": "Smoke-only (128/32 conc1). Mount it-share as /models. Add --block-size only if ATOM asserts divisibility."
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi3xx",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "roles": {
    "server": {
      "atom_args": [
        "-tp",
        "8",
        "--trust-remote-code"
      ],
      "env": {
        "ATOM_DISABLE_MMAP": "true"
      }
    }
  },
  "params": {
    "driver": "atom",
    "port_no": "8000",
    "tensor_parallelism": "8",
    "random_range_ratio": "0.8",
    "num_prompts": "25",
    "max_model_length": "2048",
    "metric_percentiles": "95,99",
    "reuse_server_across_sweep": "true",
    "server_warmup_wait_s": "900",
    "client_poll_count": "80",
    "client_poll_wait_time": "60"
  },
  "sweep": {
    "sequence_combinations": [
      {
        "name": "acc_warmup",
        "isl": "128",
        "osl": "32"
      }
    ],
    "runs": [
      {
        "combo": "acc_warmup",
        "concurrency": 1
      }
    ]
  },
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": []
  }
}
