{
  "schema_version": 2,
  "framework": "atom",
  "gpu_arch": "mi3xx",
  "default_profile": "perf",
  "threshold_json": "mi325x_atom_gpt-oss-120b_mxfp4_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "openai/gpt-oss-120b",
    "remote": 0,
    "precision": "mxfp4"
  },
  "profiles": {
    "accuracy": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "W2 ACC-1 floor 0.93; ACC-8 longctx record-only"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "rocm/atom-dev:latest",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "4",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "4",
        "num_prompts": "1",
        "max_model_length": "8192"
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "long_context_accuracy": {
        "cells": [
          {
            "id": "niah_8k",
            "isl": 8192,
            "osl": 32,
            "num_prompts": 4,
            "seed": 42
          }
        ]
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4
          },
          {
            "id": "gsm8k_longctx",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 2,
            "metadata": {
              "filter": "flexible-extract",
              "max_length": 8192
            }
          }
        ]
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "acc_warmup",
            "isl": "128",
            "osl": "32"
          }
        ],
        "runs": [
          {
            "combo": "acc_warmup",
            "concurrency": 1
          }
        ]
      }
    },
    "perf": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "W2 P1 perf via vllm_atom until native MXFP4 openai_server is qualified (--config_profile native for lab)"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx_vllm",
        "image": "rocm/atom-dev:latest",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "serve_args": {
            "trust-remote-code": true,
            "enforce-eager": true,
            "gpu-memory-utilization": "0.95",
            "block-size": 64,
            "no-enable-prefix-caching": true
          },
          "env": {
            "VLLM_ROCM_USE_AITER": "1",
            "AMDGCN_USE_BUFFER_OPS": "0",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "vllm_atom",
        "port_no": "8000",
        "tensor_parallelism": "4",
        "random_range_ratio": "0",
        "num_prompts": "1000",
        "max_model_length": "12288",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "w2_8k_1k",
            "isl": "8192",
            "osl": "1024"
          }
        ],
        "runs": [
          {
            "combo": "w2_8k_1k",
            "concurrency": 32
          },
          {
            "combo": "w2_8k_1k",
            "concurrency": 64
          }
        ]
      },
      "platform": {
        "gpu_metrics_poll": true
      }
    },
    "native": {
      "enforce_thresholds": false,
      "threshold_profile": "perf",
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "W2 native openai_server (lab only; not customer-default until MXFP4 atom path is qualified)"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "rocm/atom-dev:latest",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "4",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "4",
        "random_range_ratio": "0",
        "num_prompts": "1000",
        "max_model_length": "12288",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "w2_8k_1k",
            "isl": "8192",
            "osl": "1024"
          }
        ],
        "runs": [
          {
            "combo": "w2_8k_1k",
            "concurrency": 32
          },
          {
            "combo": "w2_8k_1k",
            "concurrency": 64
          }
        ]
      },
      "platform": {
        "gpu_metrics_poll": true
      }
    },
    "sglang": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "M4 W2 framework parity: driver=sglang"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx_sglang",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "sglang_args": [
            "--tp-size",
            "4",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "sglang",
        "port_no": "8000",
        "tensor_parallelism": "4",
        "random_range_ratio": "0",
        "num_prompts": "1000",
        "max_model_length": "12288",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "platform": {
        "gpu_metrics_poll": true
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "w2_8k_1k",
            "isl": "8192",
            "osl": "1024"
          }
        ],
        "runs": [
          {
            "combo": "w2_8k_1k",
            "concurrency": 32
          },
          {
            "combo": "w2_8k_1k",
            "concurrency": 64
          }
        ]
      }
    },
    "vllm": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "M4 W2 framework parity: driver=vllm_atom; random_range_ratio=0 (8K ISL must fit max_model_length=12288)"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx_vllm",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "serve_args": {
            "trust-remote-code": true,
            "enforce-eager": true,
            "gpu-memory-utilization": "0.95",
            "block-size": 64,
            "no-enable-prefix-caching": true
          },
          "env": {
            "VLLM_ROCM_USE_AITER": "1",
            "AMDGCN_USE_BUFFER_OPS": "0",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "vllm_atom",
        "port_no": "8000",
        "tensor_parallelism": "4",
        "random_range_ratio": "0",
        "num_prompts": "1000",
        "max_model_length": "12288",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "platform": {
        "gpu_metrics_poll": true
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "w2_8k_1k",
            "isl": "8192",
            "osl": "1024"
          }
        ],
        "runs": [
          {
            "combo": "w2_8k_1k",
            "concurrency": 32
          },
          {
            "combo": "w2_8k_1k",
            "concurrency": 64
          }
        ]
      }
    }
  },
  "_comment": "W2 GPT-OSS MXFP4: default perf uses vllm_atom; native openai_server is --config_profile native (lab). Loader falls back perf+atom to vllm_atom for legacy copies."
}
