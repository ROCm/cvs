{
  "_comment": "DeepSeek-R1-0528 FP8 single-node SGLang parity (MI355X). MI355X bring-up copy of the gfx942 recipe; thresholds are not a gate.",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_sglang_deepseek-r1_fp8_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi355x_deepseek_r1_fp8_single",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "SGLANG_USE_AITER": "1",
      "SGLANG_ROCM_ARCH": "gfx950",
      "GPU_ARCHS": "gfx950"
    }
  },
  "server_params": {
    "model": "deepseek-ai/DeepSeek-R1-0528",
    "tp": 8,
    "pp": 1,
    "nnodes": 1,
    "port": 8000,
    "max_model_length": 4096,
    "engine_args": {
      "kv_cache_dtype": "fp8_e4m3",
      "trust_remote_code": true,
      "disable_cuda_graph": true,
      "mem_fraction_static": "0.9",
      "attention_backend": "aiter"
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128",
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "gsm8k_strict",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "strict-match"
          }
        },
        {
          "id": "gsm8k_stderr",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "flexible-extract"
          }
        },
        {
          "id": "hellaswag",
          "task": "hellaswag",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "mmlu_pro",
          "task": "mmlu_pro",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "bbh",
          "task": "bbh",
          "num_fewshot": 3,
          "num_concurrent": 4
        },
        {
          "id": "musr",
          "task": "musr",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "arc_challenge",
          "task": "arc_challenge",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "winogrande",
          "task": "winogrande",
          "num_fewshot": 0,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "sglang"
  }
}
