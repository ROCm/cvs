{
  "_comment": "DeepSeek-R1-0528 FP8 distributed SGLang PP=2 across two nodes.",
  "gpu_arch": "mi3xx",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_sglang_deepseek-r1_fp8_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-R1-0528"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi3xx_deepseek_r1_fp8_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro",
          "/dev/infiniband:/dev/infiniband"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd",
          "/dev/infiniband/rdma_cm"
        ]
      }
    }
  },
  "server_params": {
    "backend": "sglang",
    "nnodes": "2",
    "log_level": "info",
    "model": "{paths.models_dir}/DeepSeek-R1-0528",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "2",
    "max_concurrency": "256",
    "memory_fraction": "0.9",
    "tokenizer_mode": "auto",
    "inference_poll_iterations": "16",
    "context_length": "4096",
    "add_flags": [
      "--kv-cache-dtype",
      "fp8_e4m3",
      "--trust-remote-code",
      "--disable-cuda-graph",
      "--mem-fraction-static",
      "0.9",
      "--attention-backend",
      "aiter"
    ],
    "server_node_list": [
      "<changeme>",
      "<changeme>"
    ],
    "dist_init_port": "29501",
    "benchmark_serv_node": "<changeme>",
    "proxy_router_serv_port": "8000",
    "env": {
      "SGLANG_USE_AITER": "1",
      "NCCL_IB_GID_INDEX": "3",
      "NCCL_DEBUG": "ERROR"
    }
  },
  "benchmark_params": {
    "backend": "sglang",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "model_num_params": "671000000000",
    "peak_gpu_tflops": "2615"
  },
  "sweeps": {
    "ISL=512,OSL=512,TP=8,PP=2,CONC=16": {},
    "ISL=512,OSL=512,TP=8,PP=2,CONC=64": {},
    "ISL=512,OSL=512,TP=8,PP=2,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=16": {},
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=64": {},
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=128": {},
    "ISL=2048,OSL=1024,TP=8,PP=2,CONC=16": {},
    "ISL=2048,OSL=1024,TP=8,PP=2,CONC=64": {},
    "ISL=2048,OSL=1024,TP=8,PP=2,CONC=128": {},
    "ISL=1024,OSL=2048,TP=8,PP=2,CONC=16": {},
    "ISL=1024,OSL=2048,TP=8,PP=2,CONC=64": {},
    "ISL=1024,OSL=2048,TP=8,PP=2,CONC=128": {},
    "ISL=2048,OSL=2048,TP=8,PP=2,CONC=16": {},
    "ISL=2048,OSL=2048,TP=8,PP=2,CONC=64": {},
    "ISL=2048,OSL=2048,TP=8,PP=2,CONC=128": {},
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1": {}
  },
  "sweep": {
    "_comment": "Combo-key runs of ISL, OSL, TP, PP, and CONC, comma-separated. Each listed run must exist in the threshold JSON. If this field is empty, every run in the threshold JSON is used.",
    "runs": []
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "hellaswag",
        "task": "hellaswag",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "mmlu_pro",
        "task": "mmlu_pro",
        "num_fewshot": 5,
        "num_concurrent": 4
      }
    ]
  }
}
