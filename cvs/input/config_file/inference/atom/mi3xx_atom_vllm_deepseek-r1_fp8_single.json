{
  "_comment": "DeepSeek-R1-0528 FP8 single-node vLLM parity (MI3xx/MI325X).",
  "schema_version": 1,
  "framework": "atom",
  "gpu_arch": "mi3xx",
  "enforce_thresholds": true,
  "threshold_json": "mi325x_atom_vllm_deepseek-r1_fp8_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-R1-0528",
    "remote": 0,
    "precision": "fp8"
  },
  "container": {
    "lifetime": "per_run",
    "name": "vllm_mi3xx_deepseek_r1_fp8_single",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/home/models:/home/models"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "server_params": {
    "backend": "vllm_atom",
    "nnodes": "1",
    "model": "deepseek-ai/DeepSeek-R1-0528",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "1",
    "port_no": "8000",
    "serve_args": {
      "kv-cache-dtype": "fp8",
      "trust-remote-code": true,
      "enforce-eager": true,
      "gpu-memory-utilization": "0.95",
      "block-size": 64,
      "no-enable-prefix-caching": true
    },
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "AMDGCN_USE_BUFFER_OPS": "0"
    }
  },
  "benchmark_params": {
    "backend": "vllm",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "metric_percentiles": "95,99",
    "client_poll_count": "80"
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128",
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "gsm8k_strict",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "strict-match"
        }
      },
      {
        "id": "gsm8k_stderr",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "flexible-extract"
        }
      },
      {
        "id": "hellaswag",
        "task": "hellaswag",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "mmlu_pro",
        "task": "mmlu_pro",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "bbh",
        "task": "bbh",
        "num_fewshot": 3,
        "num_concurrent": 4
      },
      {
        "id": "musr",
        "task": "musr",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "arc_challenge",
        "task": "arc_challenge",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "winogrande",
        "task": "winogrande",
        "num_fewshot": 0,
        "num_concurrent": 4
      }
    ]
  }
}
