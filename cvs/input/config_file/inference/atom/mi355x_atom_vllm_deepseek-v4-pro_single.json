{
  "_comment": "DeepSeek-V4-Pro FP4 single-node vLLM parity (MI355X). Bring-up beside native ATOM; thresholds are not a gate.",
  "gpu_arch": "mi355x",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_vllm_deepseek-v4-pro_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-V4-Pro",
    "remote": 0,
    "precision": "fp4"
  },
  "container": {
    "lifetime": "per_run",
    "name": "vllm_mi355x_deepseek_v4_pro",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "server_params": {
    "backend": "vllm_atom",
    "nnodes": "1",
    "model": "deepseek-ai/DeepSeek-V4-Pro",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "1",
    "port_no": "8000",
    "serve_args": {
      "trust-remote-code": true,
      "enforce-eager": true,
      "gpu-memory-utilization": "0.95",
      "block-size": 64,
      "no-enable-prefix-caching": true
    },
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "AMDGCN_USE_BUFFER_OPS": "0",
      "HF_HUB_CACHE": "{paths.shared_fs}/.cache/huggingface",
      "HF_HOME": "{paths.shared_fs}/.cache/huggingface"
    }
  },
  "benchmark_params": {
    "backend": "vllm",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "metric_percentiles": "95,99",
    "client_poll_count": "80"
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "gsm8k_strict",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "strict-match"
        }
      },
      {
        "id": "gsm8k_stderr",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "flexible-extract"
        }
      },
      {
        "id": "hellaswag",
        "task": "hellaswag",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "mmlu_pro",
        "task": "mmlu_pro",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "bbh",
        "task": "bbh",
        "num_fewshot": 3,
        "num_concurrent": 4
      },
      {
        "id": "musr",
        "task": "musr",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "arc_challenge",
        "task": "arc_challenge",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "winogrande",
        "task": "winogrande",
        "num_fewshot": 0,
        "num_concurrent": 4
      }
    ]
  }
}
