{
  "_comment": "W1 scale accuracy scaffold (tracker #50). PP=2 via vllm_atom; compare vs single-node accuracy run via CVS_ATOM_SCALE_ACCURACY_REF_JSON.",
  "schema_version": 1,
  "framework": "atom",
  "gpu_arch": "mi300x",
  "enforce_thresholds": false,
  "threshold_json": "mi300x_atom_deepseek-r1_fp8_distributed_accuracy_threshold.json",
  "run_card": {
    "atom_image_pin": "rocm/atom-dev:latest",
    "notes": "Scale accuracy parity scaffold; pair with mi300x_atom_deepseek-r1_fp8_accuracy baseline JSON"
  },
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-R1-0528",
    "remote": 0,
    "precision": "fp8"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi300x_multi",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/home/models:/home/models"
        ],
        "devices": ["/dev/dri", "/dev/kfd"]
      }
    }
  },
  "roles": {
    "server": {
      "serve_args": {
        "kv-cache-dtype": "fp8",
        "trust-remote-code": true,
        "enforce-eager": true,
        "gpu-memory-utilization": "0.95",
        "block-size": 64,
        "no-enable-prefix-caching": true
      },
      "ib_hca_devices": "auto",
      "ib_netdev": "auto",
      "env": {
        "VLLM_ROCM_USE_AITER": "1",
        "AMDGCN_USE_BUFFER_OPS": "0"
      }
    }
  },
  "params": {
    "driver": "vllm_atom",
    "port_no": "8000",
    "tensor_parallelism": "8",
    "pipeline_parallel_size": "2",
    "nnodes": "2",
    "master_addr": "{head-node-ip}",
    "master_port": "29501",
    "num_prompts": "1",
    "max_model_length": "4096",
    "client_poll_count": "80",
    "client_poll_wait_time": "60"
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {"id": "gsm8k_flex", "task": "gsm8k", "num_fewshot": 5, "num_concurrent": 4},
      {"id": "hellaswag", "task": "hellaswag", "num_fewshot": 0, "num_concurrent": 4},
      {"id": "mmlu_pro", "task": "mmlu_pro", "num_fewshot": 5, "num_concurrent": 4}
    ]
  },
  "sweep": {
    "sequence_combinations": [{"name": "acc_warmup", "isl": "128", "osl": "32"}],
    "runs": [{"combo": "acc_warmup", "concurrency": 1}]
  }
}
