{
  "_comment": "GLM-5.2-FP8 native openai_server on one mi3xx node, TP8. perf is the base server. mtp3 adds MTP with 3 speculative tokens. Thresholds stay unenforced.",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_glm-5.2_fp8_single_perf_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi3xx",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "AITER_QUICK_REDUCE_QUANTIZATION": "INT4",
      "AITER_USE_FLYDSL_MOE_SORTING": "1"
    }
  },
  "server_params": {
    "model": "zai-org/GLM-5.2-FP8",
    "tp": 8,
    "port": 8000,
    "max_model_length": 16384,
    "engine_args": {
      "kv_cache_dtype": "fp8",
      "no_enable_prefix_caching": true,
      "online_quant_config": "{\"global_quant_config\": \"ptpc_fp8\", \"exclude_layer\": [\"lm_head\", \"model.embed_tokens\", \"*.mlp.gate\"]}"
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32",
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "atom"
  }
}
