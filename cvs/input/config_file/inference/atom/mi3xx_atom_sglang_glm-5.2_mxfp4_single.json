{
  "_comment": "GLM-5.2-MXFP4 SGLang recipe, MI355 TP4. gpu_arch stays mi355x. Bring-up thresholds.",
  "gpu_arch": "mi355x",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_sglang_glm-5.2_mxfp4_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "amd/GLM-5.2-MXFP4",
    "remote": 0,
    "precision": "mxfp4"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi3xx_glm52mx_single",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "server_params": {
    "backend": "sglang",
    "nnodes": "1",
    "model": "amd/GLM-5.2-MXFP4",
    "tensor_parallelism": "4",
    "pipeline_parallelism": "1",
    "port_no": "8000",
    "log_level": "info",
    "max_concurrency": "64",
    "memory_fraction": "0.9",
    "tokenizer_mode": "auto",
    "inference_poll_iterations": "80",
    "context_length": "16384",
    "add_flags": [
      "--trust-remote-code",
      "--mem-fraction-static",
      "0.8",
      "--model-loader-extra-config",
      "{\"online_quant_config\": {\"global_quant_config\": \"ptpc_fp8\", \"exclude_layer\": [\"lm_head\", \"model.embed_tokens\", \"*.mlp.gate\", \"*expert*\"]}}"
    ],
    "benchmark_serv_node": "<changeme>",
    "proxy_router_serv_port": "8000",
    "env": {
      "AITER_QUICK_REDUCE_QUANTIZATION": "INT4",
      "AITER_USE_FLYDSL_MOE_SORTING": "1",
      "SGLANG_USE_AITER": "1",
      "SGLANG_EXTERNAL_MODEL_PACKAGE": "atom.plugin.sglang.models",
      "SGLANG_ENABLE_TORCH_COMPILE": "1",
      "TORCHINDUCTOR_COMPILE_THREADS": "128",
      "SGLANG_ROCM_ARCH": "gfx950"
    }
  },
  "benchmark_params": {
    "backend": "sglang",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "max_model_length": "16384",
    "metric_percentiles": "95,99",
    "client_poll_count": "80",
    "client_poll_wait_time": "60",
    "reuse_server_across_sweep": "true"
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=64": {},
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      }
    ]
  }
}
