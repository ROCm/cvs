{
  "_comment": "W17 DeepSeek R1 MXFP4 gsm8k accuracy on MI355X (M3 scaffold).",
  "schema_version": 1,
  "framework": "atom",
  "gpu_arch": "mi355x",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_deepseek-r1_mxfp4_accuracy_threshold.json",
  "run_card": {
    "atom_image_pin": "rocm/atom-dev:latest",
    "notes": "W17 ACC-1 floor 0.93 MXFP4 MI355X seed"
  },
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "amd/DeepSeek-R1-0528-MXFP4",
    "remote": 0,
    "precision": "mxfp4"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x",
    "image": "rocm/atom-dev:latest",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/home/models:/home/models"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "roles": {
    "server": {
      "atom_args": [
        "-tp",
        "8",
        "--trust-remote-code"
      ],
      "env": {
        "ATOM_DISABLE_MMAP": "true",
        "ATOM_USE_TRITON_MOE": "true",
        "ATOM_USE_TRITON_GEMM": "true"
      }
    }
  },
  "params": {
    "driver": "atom",
    "port_no": "8000",
    "tensor_parallelism": "8",
    "num_prompts": "1",
    "max_model_length": "4096"
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      }
    ]
  },
  "sweep": {
    "sequence_combinations": [
      {
        "name": "acc_warmup",
        "isl": "128",
        "osl": "32"
      }
    ],
    "runs": [
      {
        "combo": "acc_warmup",
        "concurrency": 1
      }
    ]
  }
}
