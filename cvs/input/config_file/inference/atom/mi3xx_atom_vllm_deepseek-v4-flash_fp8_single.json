{
  "_comment": "DeepSeek-V4-Flash FP8 single-node vLLM parity (MI3xx/MI325X). Thresholds are not a gate.",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_vllm_deepseek-v4-flash_fp8_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-V4-Flash",
    "remote": 0
  },
  "container": {
    "lifetime": "per_run",
    "name": "vllm_mi3xx_deepseek_v4_flash_fp8_single",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "server_params": {
    "backend": "vllm_atom",
    "nnodes": "1",
    "model": "deepseek-ai/DeepSeek-V4-Flash",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "1",
    "port_no": "8000",
    "serve_args": {
      "dtype": "auto",
      "kv-cache-dtype": "fp8_e4m3",
      "tokenizer-mode": "deepseek_v4",
      "moe-backend": "triton_unfused",
      "trust-remote-code": true,
      "enforce-eager": true,
      "gpu-memory-utilization": "0.9",
      "block-size": 256,
      "no-enable-prefix-caching": true
    },
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "VLLM_ROCM_USE_AITER_LINEAR": "1",
      "VLLM_DSV4_ROCM_GRAPH_SAFE": "0",
      "VLLM_USE_BREAKABLE_CUDAGRAPH": "0",
      "AMDGCN_USE_BUFFER_OPS": "0"
    }
  },
  "benchmark_params": {
    "backend": "vllm",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "max_model_length": "12288",
    "metric_percentiles": "95,99",
    "client_poll_count": "80",
    "client_poll_wait_time": "60",
    "reuse_server_across_sweep": "true"
  },
  "sweeps": {
    "ISL=5000,OSL=1024,TP=8,PP=1,CONC=16": {},
    "ISL=5000,OSL=1024,TP=8,PP=1,CONC=32": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "gsm8k_strict",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "strict-match"
        }
      },
      {
        "id": "gsm8k_stderr",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4,
        "metadata": {
          "filter": "flexible-extract"
        }
      },
      {
        "id": "hellaswag",
        "task": "hellaswag",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "mmlu_pro",
        "task": "mmlu_pro",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "bbh",
        "task": "bbh",
        "num_fewshot": 3,
        "num_concurrent": 4
      },
      {
        "id": "musr",
        "task": "musr",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "arc_challenge",
        "task": "arc_challenge",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "winogrande",
        "task": "winogrande",
        "num_fewshot": 0,
        "num_concurrent": 4
      }
    ]
  }
}
