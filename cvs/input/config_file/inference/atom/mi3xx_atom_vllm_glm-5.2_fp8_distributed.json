{
  "_comment": "GLM-5.2-FP8 vLLM on two mi3xx nodes, TP8 PP2. Thresholds stay unenforced.",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_vllm_glm-5.2_fp8_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "vllm_mi3xx_glm52fp8_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>",
          "/dev/infiniband:/dev/infiniband"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd",
          "/dev/infiniband/rdma_cm"
        ]
      }
    },
    "env": {
      "AITER_QUICK_REDUCE_QUANTIZATION": "INT4",
      "AITER_USE_FLYDSL_MOE_SORTING": "1",
      "NCCL_IB_GID_INDEX": "3",
      "NCCL_DEBUG": "ERROR"
    }
  },
  "server_params": {
    "model": "zai-org/GLM-5.2-FP8",
    "tp": 8,
    "pp": 2,
    "nnodes": 2,
    "port": 8000,
    "master_port": 29501,
    "max_model_length": 16384,
    "engine_args": {
      "async_scheduling": true,
      "load_format": "fastsafetensors",
      "trust_remote_code": true,
      "compilation_config": "{\"cudagraph_mode\": \"FULL_AND_PIECEWISE\"}",
      "kv_cache_dtype": "fp8",
      "max_num_batched_tokens": 16384,
      "gpu_memory_utilization": "0.9",
      "no_enable_prefix_caching": true,
      "additional_config": "{\"online_quant_config\": {\"global_quant_config\": \"ptpc_fp8\", \"exclude_layer\": [\"lm_head\", \"model.embed_tokens\", \"*.mlp.gate\"]}}"
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 9120
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=32": {},
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=64": {},
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=32",
    "ISL=1024,OSL=1024,TP=8,PP=2,CONC=64",
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "vllm_atom"
  }
}
