{
  "_comment": "Kimi K2.7-Code MXFP4 on MI355X/gfx950, TP4. Native MXFP4 \u2014 do not use as a gfx942 gate. Bring-up stem for Spur/managed 355 labs. Calibrate thresholds after the first clean run.",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_kimi-k27-code_mxfp4_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "ATOM_DISABLE_MMAP": "true"
    }
  },
  "server_params": {
    "model": "moonshotai/Kimi-K2.7-Code",
    "tp": 4,
    "port": 8000,
    "max_model_length": 4096,
    "engine_args": {
      "trust_remote_code": true
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32": {},
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32",
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1"
  ],
  "atom": {
    "driver": "atom"
  }
}
