{
  "_comment": "Kimi K2.7-Code MXFP4 on MI355X/gfx950, TP4. Native MXFP4 — do not use as a gfx942 gate. Bring-up stem for Spur/managed 355 labs. Calibrate thresholds after the first clean run.",
  "threshold_json": "mi355x_atom_kimi-k27-code_mxfp4_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "moonshotai/Kimi-K2.7-Code",
    "remote": 0,
    "precision": "mxfp4"
  },
  "enforce_thresholds": false,
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    }
  },
  "roles": {
    "server": {
      "atom_args": [
        "-tp",
        "4",
        "--trust-remote-code"
      ],
      "env": {
        "ATOM_DISABLE_MMAP": "true"
      }
    }
  },
  "params": {
    "driver": "atom",
    "port_no": "8000",
    "tensor_parallelism": "4",
    "random_range_ratio": "0.8",
    "num_prompts": "1000",
    "max_model_length": "4096",
    "metric_percentiles": "95,99",
    "reuse_server_across_sweep": "true",
    "client_poll_count": "80",
    "client_poll_wait_time": "60"
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=4,PP=1,CONC=32": {},
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  }
}
