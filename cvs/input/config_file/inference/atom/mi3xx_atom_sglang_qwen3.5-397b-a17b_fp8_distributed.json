{
  "_comment": "Qwen3.5-397B-A17B FP8 distributed SGLang PP=2. Same Qwen3.5 hybrid/AITER flags as single-node; image must ship aiter.ops.flydsl.moe_common.",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_sglang_qwen3.5-397b-a17b_fp8_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi3xx_qwen397b_fp8_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>",
          "/dev/infiniband:/dev/infiniband"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd",
          "/dev/infiniband/rdma_cm"
        ]
      }
    },
    "env": {
      "SGLANG_USE_AITER": "1",
      "SGLANG_ROCM_ARCH": "gfx942",
      "GPU_ARCHS": "gfx942",
      "NCCL_IB_GID_INDEX": "3",
      "NCCL_DEBUG": "ERROR"
    }
  },
  "server_params": {
    "model": "amd/Qwen3.5-397B-A17B-FP8",
    "tp": 8,
    "pp": 2,
    "nnodes": 2,
    "port": 8000,
    "master_port": 29501,
    "max_model_length": 12288,
    "engine_args": {
      "kv_cache_dtype": "fp8_e4m3",
      "trust_remote_code": true,
      "disable_cuda_graph": true,
      "mem_fraction_static": "0.9",
      "attention_backend": "aiter",
      "mamba_radix_cache_strategy": "no_buffer",
      "disable_overlap_schedule": true
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 9120
  },
  "sweeps": {
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=32": {},
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=64": {},
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=32",
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=64",
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "hellaswag",
          "task": "hellaswag",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "mmlu_pro",
          "task": "mmlu_pro",
          "num_fewshot": 5,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "sglang"
  }
}
