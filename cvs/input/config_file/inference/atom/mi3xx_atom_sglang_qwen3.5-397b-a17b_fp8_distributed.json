{
  "_comment": "Qwen3.5-397B-A17B FP8 distributed SGLang PP=2 across two nodes.",
  "gpu_arch": "mi3xx",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_sglang_qwen3.5-397b-a17b_fp8_distributed_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "amd/Qwen3.5-397B-A17B-FP8",
    "remote": 0,
    "precision": "fp8"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi3xx_qwen397b_fp8_distributed",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme-models-mount>:/models:ro",
          "/dev/infiniband:/dev/infiniband"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd",
          "/dev/infiniband/rdma_cm"
        ]
      }
    }
  },
  "server_params": {
    "backend": "sglang",
    "nnodes": "2",
    "log_level": "info",
    "model": "{paths.models_dir}/Qwen3.5-397B-A17B-FP8",
    "tensor_parallelism": "8",
    "pipeline_parallelism": "2",
    "max_concurrency": "64",
    "memory_fraction": "0.9",
    "tokenizer_mode": "auto",
    "inference_poll_iterations": "120",
    "context_length": "12288",
    "add_flags": [
      "--kv-cache-dtype",
      "fp8_e4m3",
      "--trust-remote-code",
      "--disable-cuda-graph",
      "--mem-fraction-static",
      "0.9",
      "--attention-backend",
      "aiter"
    ],
    "server_node_list": [
      "<changeme>",
      "<changeme>"
    ],
    "dist_init_port": "29501",
    "benchmark_serv_node": "<changeme>",
    "proxy_router_serv_port": "8000",
    "env": {
      "SGLANG_USE_AITER": "1",
      "NCCL_IB_GID_INDEX": "3",
      "NCCL_DEBUG": "ERROR"
    }
  },
  "benchmark_params": {
    "backend": "sglang",
    "data_set_name": "random",
    "num_prompts": "1000",
    "random_range_ratio": "0.8",
    "model_num_params": "397000000000",
    "peak_gpu_tflops": "2615",
    "metric_percentiles": "95,99",
    "client_poll_count": "150",
    "client_poll_wait_time": "60",
    "reuse_server_across_sweep": "true"
  },
  "sweeps": {
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=32": {},
    "ISL=1024,OSL=8192,TP=8,PP=2,CONC=64": {},
    "ISL=128,OSL=32,TP=8,PP=2,CONC=1": {}
  },
  "runs": [],
  "platform": {
    "gpu_metrics_poll": true
  },
  "functional": {
    "api_smoke": true,
    "health_check": true
  },
  "accuracy": {
    "tasks": [
      {
        "id": "gsm8k_flex",
        "task": "gsm8k",
        "num_fewshot": 5,
        "num_concurrent": 4
      },
      {
        "id": "hellaswag",
        "task": "hellaswag",
        "num_fewshot": 0,
        "num_concurrent": 4
      },
      {
        "id": "mmlu_pro",
        "task": "mmlu_pro",
        "num_fewshot": 5,
        "num_concurrent": 4
      }
    ]
  }
}
