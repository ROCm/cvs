{
  "_comment": "GPT-OSS-120B MXFP4 single-node vLLM parity (MI3xx/MI325X, W2). Requires an image with the vllm package. Native ATOM openai_server is not shipped: AITER shuffle_scale_moe UnboundLocalError on gfx942 (rc4 / atom-dev).",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_vllm_gpt-oss-120b_mxfp4_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi3xx_vllm",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "VLLM_ROCM_USE_AITER": "1",
      "AMDGCN_USE_BUFFER_OPS": "0",
      "ATOM_USE_TRITON_MOE": "1",
      "ATOM_USE_TRITON_GEMM": "1"
    }
  },
  "server_params": {
    "model": "openai/gpt-oss-120b",
    "tp": 4,
    "pp": 1,
    "nnodes": 1,
    "port": 8000,
    "max_model_length": 12288,
    "engine_args": {
      "trust_remote_code": true,
      "enforce_eager": true,
      "gpu_memory_utilization": "0.95",
      "block_size": 64,
      "no_enable_prefix_caching": true
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.0
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=32": {},
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=64": {},
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=32",
    "ISL=8192,OSL=1024,TP=4,PP=1,CONC=64",
    "ISL=128,OSL=32,TP=4,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "gsm8k_longctx",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 2,
          "metadata": {
            "filter": "flexible-extract",
            "max_length": 8192
          }
        }
      ]
    },
    "custom_eval": [
      {
        "id": "niah_8k",
        "isl": 8192,
        "osl": 32,
        "num_prompts": 4,
        "seed": 42,
        "type": "niah"
      }
    ]
  },
  "atom": {
    "driver": "vllm_atom"
  }
}
