{
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_deepseek-r1_fp8_single_perf_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "ATOM_DISABLE_MMAP": "true"
    }
  },
  "server_params": {
    "model": "deepseek-ai/DeepSeek-R1-0528",
    "tp": 8,
    "port": 8000,
    "max_model_length": 4096,
    "engine_args": {
      "kv_cache_dtype": "fp8",
      "trust_remote_code": true
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128",
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=256",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "gsm8k_strict",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "strict-match"
          }
        },
        {
          "id": "gsm8k_stderr",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4,
          "metadata": {
            "filter": "flexible-extract"
          }
        },
        {
          "id": "hellaswag",
          "task": "hellaswag",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "mmlu_pro",
          "task": "mmlu_pro",
          "num_fewshot": 5,
          "num_concurrent": 4
        },
        {
          "id": "bbh",
          "task": "bbh",
          "num_fewshot": 3,
          "num_concurrent": 4
        },
        {
          "id": "musr",
          "task": "musr",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "arc_challenge",
          "task": "arc_challenge",
          "num_fewshot": 0,
          "num_concurrent": 4
        },
        {
          "id": "winogrande",
          "task": "winogrande",
          "num_fewshot": 0,
          "num_concurrent": 4
        }
      ]
    },
    "quant_parity": {
      "enabled": true,
      "probe_prompt": "The capital of France is",
      "reference_config_stem": ""
    }
  },
  "atom": {
    "driver": "atom"
  }
}
