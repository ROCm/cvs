{
  "_comment": "Tracker #10 DeepSeek V4 Pro — vLLM-ATOM multinode PP=2 (2x8 GPU, 5000/1024). Requires V4-capable vLLM image.",
  "schema_version": 1,
  "framework": "atom",
  "gpu_arch": "mi355x",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_deepseek-v4-pro_distributed_threshold.json",
  "run_card": {
    "atom_image_pin": "rocm/atom-dev:latest",
    "notes": "P1 tracker #10 multinode vLLM; set ib_netdev, master_addr, container.image"
  },
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "deepseek-ai/DeepSeek-V4-Pro",
    "remote": 0,
    "precision": "fp4+fp8"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x_multi",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "/home/models:/home/models"
        ],
        "devices": ["/dev/dri", "/dev/kfd"]
      }
    }
  },
  "roles": {
    "server": {
      "serve_args": {
        "dtype": "auto",
        "kv-cache-dtype": "fp8_e4m3",
        "trust-remote-code": true,
        "tokenizer-mode": "deepseek_v4",
        "moe-backend": "triton_unfused",
        "gpu-memory-utilization": "0.9",
        "block-size": 64,
        "no-enable-prefix-caching": true,
        "enforce-eager": false,
        "compilation-config": "{\"mode\":3,\"cudagraph_mode\":\"FULL_AND_PIECEWISE\"}"
      },
      "ib_hca_devices": "auto",
      "ib_netdev": "auto",
      "env": {
        "VLLM_ROCM_USE_AITER": "1",
        "VLLM_ROCM_USE_AITER_LINEAR": "1",
        "VLLM_DSV4_ROCM_GRAPH_SAFE": "1",
        "AMDGCN_USE_BUFFER_OPS": "0"
      }
    }
  },
  "params": {
    "driver": "vllm_atom",
    "port_no": "8000",
    "tensor_parallelism": "8",
    "pipeline_parallel_size": "2",
    "nnodes": "2",
    "master_addr": "{head-node-ip}",
    "master_port": "29501",
    "tokenizer_mode": "deepseek_v4",
    "scaling_baseline_output_throughput": "1500",
    "random_range_ratio": "0.8",
    "num_prompts": "1000",
    "max_model_length": "10240",
    "metric_percentiles": "95,99",
    "reuse_server_across_sweep": "true",
    "server_precheck_wait_s": "30",
    "server_warmup_wait_s": "600",
    "server_poll_count": "180",
    "server_poll_wait_time": "60",
    "client_poll_count": "150",
    "client_poll_wait_time": "60"
  },
  "platform": {
    "gpu_metrics_poll": true
  },
  "sweep": {
    "sequence_combinations": [
      {"name": "v4pro_5k_1k", "isl": "5000", "osl": "1024"}
    ],
    "runs": [
      {"combo": "v4pro_5k_1k", "concurrency": 16},
      {"combo": "v4pro_5k_1k", "concurrency": 32}
    ]
  }
}
