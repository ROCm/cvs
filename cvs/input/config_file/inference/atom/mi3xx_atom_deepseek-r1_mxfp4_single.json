{
  "_comment": "DeepSeek-R1 MXFP4 native openai_server for amd/DeepSeek-R1-0528-MXFP4, TP8, FP8 KV. gpu_arch stays mi355x because the vLLM and SGLang MXFP4 sections are MI355X. Bring-up thresholds. Select perf for amd/DeepSeek-R1-0528-MXFP4 or mtp3 for amd/DeepSeek-R1-0528-MXFP4-MTP-MoEFP4.",
  "gpu_arch": "mi355x",
  "schema_version": 2,
  "framework": "atom",
  "threshold_json": "mi325x_atom_deepseek-r1_mxfp4_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "amd/DeepSeek-R1-0528-MXFP4",
    "remote": 0,
    "precision": "mxfp4"
  },
  "default_profile": "perf",
  "profiles": {
    "perf": {
      "enforce_thresholds": false,
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "<changeme-models-mount>:/models:ro"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--kv_cache_dtype",
            "fp8"
          ],
          "env": {}
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "random_range_ratio": "0.8",
        "num_prompts": "1000",
        "max_model_length": "16384",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "sweeps": {
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
        "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
      },
      "runs": [],
      "platform": {
        "gpu_metrics_poll": true
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4
          }
        ]
      }
    },
    "mtp3": {
      "enforce_thresholds": false,
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "<changeme>",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "<changeme-models-mount>:/models:ro"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--kv_cache_dtype",
            "fp8",
            "--method",
            "mtp",
            "--num-speculative-tokens",
            "3"
          ],
          "env": {}
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "random_range_ratio": "0.8",
        "num_prompts": "1000",
        "max_model_length": "16384",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "sweeps": {
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
        "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
        "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
      },
      "runs": [],
      "platform": {
        "gpu_metrics_poll": true
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4
          }
        ]
      },
      "model": {
        "id": "amd/DeepSeek-R1-0528-MXFP4-MTP-MoEFP4",
        "remote": 0,
        "precision": "mxfp4"
      }
    }
  }
}
