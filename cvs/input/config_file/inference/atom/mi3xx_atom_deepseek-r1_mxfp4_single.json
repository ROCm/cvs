{
  "schema_version": 2,
  "framework": "atom",
  "default_profile": "perf",
  "threshold_json": "mi325x_atom_deepseek-r1_mxfp4_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/home/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "model": {
    "id": "amd/DeepSeek-R1-0528-MXFP4",
    "remote": 0,
    "precision": "mxfp4"
  },
  "profiles": {
    "accuracy": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "W17 ACC-1 floor 0.93 MXFP4"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "rocm/atom-dev:latest",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "num_prompts": "1",
        "max_model_length": "4096"
      },
      "functional": {
        "api_smoke": true,
        "health_check": true
      },
      "accuracy": {
        "tasks": [
          {
            "id": "gsm8k_flex",
            "task": "gsm8k",
            "num_fewshot": 5,
            "num_concurrent": 4
          }
        ]
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "acc_warmup",
            "isl": "128",
            "osl": "32"
          }
        ],
        "runs": [
          {
            "combo": "acc_warmup",
            "concurrency": 1
          }
        ]
      }
    },
    "perf": {
      "enforce_thresholds": false,
      "run_card": {
        "atom_image_pin": "rocm/atom-dev:latest",
        "notes": "W17 P1 MXFP4 reasoning; gsm8k floor 0.93 on accuracy variant"
      },
      "container": {
        "lifetime": "per_run",
        "name": "atom_mi3xx",
        "image": "rocm/atom-dev:latest",
        "runtime": {
          "name": "docker",
          "args": {
            "network": "host",
            "ipc": "host",
            "privileged": true,
            "shm_size": "128G",
            "volumes": [
              "/home/{user-id}:/home/{user-id}",
              "/home/models:/home/models"
            ],
            "devices": [
              "/dev/dri",
              "/dev/kfd"
            ]
          }
        }
      },
      "roles": {
        "server": {
          "atom_args": [
            "-tp",
            "8",
            "--trust-remote-code"
          ],
          "env": {
            "ATOM_DISABLE_MMAP": "true",
            "ATOM_USE_TRITON_MOE": "1",
            "ATOM_USE_TRITON_GEMM": "1"
          }
        }
      },
      "params": {
        "driver": "atom",
        "port_no": "8000",
        "tensor_parallelism": "8",
        "random_range_ratio": "0.8",
        "num_prompts": "1000",
        "max_model_length": "4096",
        "metric_percentiles": "95,99",
        "reuse_server_across_sweep": "true",
        "client_poll_count": "80",
        "client_poll_wait_time": "60"
      },
      "sweep": {
        "sequence_combinations": [
          {
            "name": "w17_1k_1k",
            "isl": "1024",
            "osl": "1024"
          }
        ],
        "runs": [
          {
            "combo": "w17_1k_1k",
            "concurrency": 128
          },
          {
            "combo": "w17_1k_1k",
            "concurrency": 256
          }
        ]
      },
      "platform": {
        "gpu_metrics_poll": true
      }
    }
  },
  "_comment": "W17 DeepSeek R1 MXFP4 gsm8k accuracy (M3 scaffold). enforce_thresholds false until W17 perf variant lands in lab."
}
