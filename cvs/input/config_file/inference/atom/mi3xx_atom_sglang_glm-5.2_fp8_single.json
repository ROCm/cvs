{
  "_comment": "GLM-5.2-FP8 SGLang on one mi3xx node, TP8. Thresholds stay unenforced. memory_fraction is not forwarded to launch_server; the server uses --mem-fraction-static 0.8.",
  "enforce_thresholds": false,
  "threshold_json": "mi325x_atom_sglang_glm-5.2_fp8_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "sglang_mi3xx_glm52fp8_single",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "AITER_QUICK_REDUCE_QUANTIZATION": "INT4",
      "AITER_USE_FLYDSL_MOE_SORTING": "1",
      "SGLANG_USE_AITER": "1",
      "SGLANG_EXTERNAL_MODEL_PACKAGE": "atom.plugin.sglang.models",
      "SGLANG_ENABLE_TORCH_COMPILE": "1",
      "TORCHINDUCTOR_COMPILE_THREADS": "128",
      "SGLANG_AITER_FP8_PREFILL_ATTN": "0"
    }
  },
  "server_params": {
    "model": "zai-org/GLM-5.2-FP8",
    "tp": 8,
    "pp": 1,
    "nnodes": 1,
    "port": 8000,
    "max_model_length": 16384,
    "engine_args": {
      "context_length": "16384",
      "trust_remote_code": true,
      "mem_fraction_static": "0.8",
      "model_loader_extra_config": "{\"online_quant_config\": {\"global_quant_config\": \"ptpc_fp8\", \"exclude_layer\": [\"lm_head\", \"model.embed_tokens\", \"*.mlp.gate\"]}}"
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32": {},
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=32",
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=64",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "sglang"
  }
}
