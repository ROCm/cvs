{
  "_comment": "DeepSeek-V4-Pro on MI355X/gfx950, TP8. Official Pro SKU (native FP4). Bring-up stem \u2014 confirm atom_args against the image recipe after first start.",
  "enforce_thresholds": false,
  "threshold_json": "mi355x_atom_deepseek-v4-pro_single_threshold.json",
  "paths": {
    "shared_fs": "/home/{user-id}",
    "models_dir": "/models",
    "log_dir": "{shared_fs}/LOGS",
    "hf_token_file": "{shared_fs}/.hf_token"
  },
  "container": {
    "lifetime": "per_run",
    "name": "atom_mi355x",
    "image": "<changeme>",
    "runtime": {
      "name": "docker",
      "args": {
        "network": "host",
        "ipc": "host",
        "privileged": true,
        "shm_size": "128G",
        "volumes": [
          "/home/{user-id}:/home/{user-id}",
          "<changeme>"
        ],
        "_volumes_example": [
          "/data/models:/models:ro"
        ],
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ]
      }
    },
    "env": {
      "ATOM_DISABLE_MMAP": "true"
    }
  },
  "server_params": {
    "model": "deepseek-ai/DeepSeek-V4-Pro",
    "tp": 8,
    "port": 8000,
    "max_model_length": 4096,
    "engine_args": {
      "trust_remote_code": true
    }
  },
  "benchmark_params": {
    "num_prompts": 1000,
    "random_range_ratio": 0.8
  },
  "timeouts": {
    "client_s": 4920
  },
  "sweeps": {
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128": {},
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1": {}
  },
  "runs": [
    "ISL=1024,OSL=1024,TP=8,PP=1,CONC=128",
    "ISL=128,OSL=32,TP=8,PP=1,CONC=1"
  ],
  "accuracy": {
    "lm_eval": {
      "tasks": [
        {
          "id": "gsm8k_flex",
          "task": "gsm8k",
          "num_fewshot": 5,
          "num_concurrent": 4
        }
      ]
    }
  },
  "atom": {
    "driver": "atom"
  }
}
