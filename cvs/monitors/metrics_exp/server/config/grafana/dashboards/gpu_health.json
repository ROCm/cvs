{
  "uid": "gpu-health",
  "title": "GPU Health & Errors",
  "description": "Detailed GPU health status, ECC errors, and RAS events",
  "tags": ["gpu-fleet", "health", "ecc", "ras"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "nodegroup",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(gpu_power_usage, node_group)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "hostname",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(gpu_power_usage{node_group=~\"$nodegroup\"}, hostname)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health Overview",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total GPUs",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "targets": [{"expr": "count(gpu_power_usage{node_group=~\"$nodegroup\", hostname=~\"$hostname\"})", "legendFormat": "Total"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Healthy GPUs",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "targets": [{"expr": "count(gpu_health{node_group=~\"$nodegroup\", hostname=~\"$hostname\"} == 1) or count(gpu_power_usage{node_group=~\"$nodegroup\", hostname=~\"$hostname\"} > 0)", "legendFormat": "Healthy"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ECC Errors (Uncorrectable)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "targets": [{"expr": "sum(gpu_ecc_uncorrect_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}) or vector(0)", "legendFormat": "UE Errors"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "ECC Errors (Correctable)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "targets": [{"expr": "sum(gpu_ecc_correct_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}) or vector(0)", "legendFormat": "CE Errors"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}]}}}
    },
    {
      "id": 6,
      "type": "row",
      "title": "GPU Health Status",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU Power Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "targets": [{"expr": "gpu_power_usage{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}}"}],
      "fieldConfig": {"defaults": {"unit": "watt", "custom": {"lineWidth": 1}}}
    },
    {
      "id": 8,
      "type": "row",
      "title": "ECC Errors",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Uncorrectable ECC Errors",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [{"expr": "gpu_ecc_uncorrect_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}}"}],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2}}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Correctable ECC Errors",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [{"expr": "gpu_ecc_correct_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}}"}],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 2}}}
    },
    {
      "id": 11,
      "type": "row",
      "title": "Top 10 Nodes by ECC Errors",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}
    },
    {
      "id": 30,
      "type": "barchart",
      "title": "Top 10 Nodes by Uncorrectable ECC Errors",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "topk(10, sum by (hostname) (gpu_ecc_uncorrect_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}))", "legendFormat": "{{hostname}}", "instant": true}],
      "options": {"orientation": "horizontal", "showValue": "always"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 31,
      "type": "barchart",
      "title": "Top 10 Nodes by Correctable ECC Errors",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "topk(10, sum by (hostname) (gpu_ecc_correct_total{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}))", "legendFormat": "{{hostname}}", "instant": true}],
      "options": {"orientation": "horizontal", "showValue": "always"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}]}}}
    },
    {
      "id": 12,
      "type": "row",
      "title": "Detailed ECC by Component",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "ECC Errors by Component (Correctable)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "targets": [
        {"expr": "gpu_ecc_correct_umc{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} UMC"},
        {"expr": "gpu_ecc_correct_gfx{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} GFX"},
        {"expr": "gpu_ecc_correct_sdma{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} SDMA"}
      ],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1}}}
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "ECC Errors by Component (Uncorrectable)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "targets": [
        {"expr": "gpu_ecc_uncorrect_umc{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} UMC"},
        {"expr": "gpu_ecc_uncorrect_gfx{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} GFX"},
        {"expr": "gpu_ecc_uncorrect_sdma{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}} SDMA"}
      ],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1}}}
    },

    {
      "id": 40,
      "type": "row",
      "title": "PCIe Metrics",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41}
    },
    {
      "id": 41,
      "type": "stat",
      "title": "PCIe Bandwidth (Avg)",
      "description": "Average PCIe bandwidth utilization across all GPUs",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 42},
      "targets": [{"expr": "avg(gpu_pcie_bw{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}) or vector(0)", "legendFormat": "Avg BW"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "Bps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 42,
      "type": "stat",
      "title": "PCIe Replay Count",
      "description": "Total PCIe replay errors (indicates link quality issues)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 42},
      "targets": [{"expr": "sum(gpu_pcie_replay{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}) or vector(0)", "legendFormat": "Replays"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}}}
    },
    {
      "id": 43,
      "type": "stat",
      "title": "PCIe Width (Most Common)",
      "description": "PCIe lane width - expect x16 for optimal performance",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 42},
      "targets": [{"expr": "topk(1, count by (pcie_width) (gpu_pcie_width{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}))", "legendFormat": "x{{pcie_width}}"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 44,
      "type": "stat",
      "title": "PCIe Speed (Most Common)",
      "description": "PCIe generation/speed",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 42},
      "targets": [{"expr": "topk(1, count by (pcie_speed) (gpu_pcie_speed{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}))", "legendFormat": "Gen {{pcie_speed}}"}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "PCIe Bandwidth Over Time",
      "description": "PCIe bandwidth utilization per GPU",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46},
      "targets": [{"expr": "gpu_pcie_bw{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}", "legendFormat": "{{hostname}} GPU{{gpu_id}}"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 1}}}
    },
    {
      "id": 46,
      "type": "timeseries",
      "title": "PCIe Replay Errors Over Time",
      "description": "PCIe replay count increase (link retransmissions)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46},
      "targets": [{"expr": "increase(gpu_pcie_replay{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}[5m])", "legendFormat": "{{hostname}} GPU{{gpu_id}}"}],
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 47,
      "type": "table",
      "title": "PCIe Configuration by GPU",
      "description": "Current PCIe width and speed for each GPU",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 54},
      "targets": [
        {
          "expr": "gpu_pcie_width{node_group=~\"$nodegroup\", hostname=~\"$hostname\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "node_group": true}, "renameByName": {"hostname": "Host", "gpu_id": "GPU", "Value": "Width (lanes)"}}}
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "center"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Width (lanes)"}, "properties": [{"id": "custom.displayMode", "value": "color-text"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 8}, {"color": "green", "value": 16}]}}]}
        ]
      }
    },

    {
      "id": 50,
      "type": "row",
      "title": "GPU Driver Errors (Logs)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 62}
    },
    {
      "id": 51,
      "type": "stat",
      "title": "Critical GPU Errors (24h)",
      "description": "Count of amdgpu emerg/crit/err level messages in the last 24 hours",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 63},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(count_over_time({node_group=~\"$nodegroup\", host=~\"$hostname\"} |~ \"(?i)(amdgpu.*error|amdgpu.*fail|amdgpu.*timeout|gpu.*hang|gpu.*reset|ras.*error|ecc.*error)\"[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 52,
      "type": "stat",
      "title": "GPU Hangs/Resets (24h)",
      "description": "GPU hang and reset events",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 63},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(count_over_time({node_group=~\"$nodegroup\", host=~\"$hostname\"} |~ \"(?i)(gpu.*hang|gpu.*reset|amdgpu.*reset|ring.*hang)\"[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 53,
      "type": "stat",
      "title": "PCIe/AER Errors (24h)",
      "description": "PCIe Advanced Error Reporting events",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 63},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(count_over_time({node_group=~\"$nodegroup\", host=~\"$hostname\"} |~ \"(?i)(AER.*error|AER.*Uncorrected|pcieport.*error|pcie.*fatal)\"[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 54,
      "type": "stat",
      "title": "XGMI Errors (24h)",
      "description": "XGMI interconnect errors between GPUs",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 63},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(count_over_time({node_group=~\"$nodegroup\", host=~\"$hostname\"} |~ \"(?i)(xgmi.*error|xgmi.*fail)\"[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 55,
      "type": "logs",
      "title": "AMDGPU Critical Error Logs",
      "description": "All amdgpu-related emerg, crit, and err level messages from dmesg/journal. Empty when no errors detected.",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 67},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{node_group=~\"$nodegroup\", host=~\"$hostname\"} |~ \"(?i)(amdgpu.*error|amdgpu.*fail|amdgpu.*timeout|gpu.*hang|gpu.*reset|amdgpu.*reset|ring.*hang|ras.*error|ras.*event|ecc.*error|xgmi.*error|xgmi.*fail|AER.*error|AER.*Uncorrected|pcieport.*amdgpu|pcie.*fatal.*amdgpu|drm.*error|kfd.*error)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
