# Backend Configuration
DEBUG=false
CLUSTER_MONITOR_HOME=/app

# Required. Uid and gid of the account that owns ./config and the SSH key
# (`id -u` and `id -g`). Compose will not start if either is empty.
# Do not set 0.
CLUSTER_MON_UID=
CLUSTER_MON_GID=
# Required. Home directory of the account above. Compose bind-mounts
# $CLUSTER_MON_HOME/.ssh at the same path in the container and sets HOME.
# cluster.yaml key paths are ~/.ssh/<filename>.
CLUSTER_MON_HOME=

# Polling Configuration
POLLING__INTERVAL=60
POLLING__FAILURE_THRESHOLD=5

# Host port published to the machine (container still listens on 8001).
# CLUSTER_MON_PORT=8005

# Optional shared secret for /api/config/*.
# When set, send Authorization: Bearer <token> or X-API-Token.
# The stock React UI does not send this — use a reverse proxy that injects it,
# or leave unset (same unauthenticated hole as before).
# CLUSTER_MON_API_TOKEN=

# Comma-separated CORS origins for a separately hosted UI (Vite). Same-origin
# SPA served from this binary does not need CORS.
# CORS_ORIGINS=http://localhost:5173

# Frontend Configuration (for development)
VITE_API_URL=http://localhost:8001/api
VITE_WS_URL=ws://localhost:8001/ws/metrics
