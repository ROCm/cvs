{
  "schema_version": 1,
  "profile_id": "megatron_rundeck",
  "suite_id": "megatron",
  "report_basename": "megatron_run_deck",
  "title": "Megatron Run Deck",
  "subtitle": "Megatron · single-node & distributed training summary",
  "footer": "CVS megatron · render-only · does not affect gates",
  "link_name": "Megatron Run Deck",
  "dataset_builder": "training_sweep",
  "interactive_viewer": false,
  "sources": {
    "results": "train_res_dict",
    "variant": "variant_config",
    "lifecycle": "lifecycle"
  },
  "hooks": {
    "tier_metric_specs": "cvs.lib.training.megatron.utils.megatron_metrics:tier_metric_specs",
    "metric_units": "cvs.lib.training.megatron.utils.megatron_metrics:METRIC_UNITS",
    "run_card_display": "cvs.lib.report.profiles.hooks.megatron_run_card:megatron_run_card_display"
  },
  "sweep": {
    "metric_prefix": "training.",
    "throughput_metric": "training.throughput_per_gpu",
    "ttft_metric": "training.elapsed_time_per_iteration",
    "headline_metric": "training.throughput_per_gpu",
    "tier_order": ["throughput", "latency", "health", "record"],
    "results_table_columns": [
      ["Model", null],
      ["GPU", null],
      ["MBS", null],
      ["GBS", null],
      ["Precision", null],
      ["TP", null],
      ["PP", null],
      ["Tok/s/GPU", "training.tokens_per_gpu"],
      ["TFLOP/s/GPU", "training.throughput_per_gpu"],
      ["Iter time (s)", "training.elapsed_time_per_iteration"],
      ["Mem usage", "training.mem_usage"],
      ["Scaling eff. (%)", "training.scaling_efficiency_pct"]
    ],
    "cell_highlights": [
      ["throughput_per_gpu", "TFLOP/s/GPU"],
      ["tokens_per_gpu", "Tok/s/GPU"],
      ["elapsed_time_per_iteration", "Iter time (s)"],
      ["mem_usage", "Mem usage"],
      ["scaling_efficiency_pct", "Scaling eff. (%)"]
    ],
    "chart_series": [
      {"metric_suffix": "throughput_per_gpu", "title": "TFLOP/s/GPU", "unit": "TFLOP/s/GPU", "invert": false},
      {"metric_suffix": "elapsed_time_per_iteration", "title": "Iteration time", "unit": "s", "invert": true},
      {"metric_suffix": "tokens_per_gpu", "title": "Tokens/s/GPU", "unit": "tok/s/GPU", "invert": false},
      {"metric_suffix": "scaling_efficiency_pct", "title": "Scaling efficiency", "unit": "%", "invert": false},
      {"metric_suffix": "steps_to_target", "title": "Steps to target", "unit": "steps", "invert": true},
      {"metric_suffix": "time_to_target_seconds", "title": "Time to target", "unit": "s", "invert": true}
    ]
  },
  "lifecycle": {
    "session_labels": [
      "container_launch",
      "tokenizer_download",
      "smoke",
      "training",
      "teardown"
    ],
    "cell_labels": ["training"]
  },
  "behavior": {
    "inference_test_substring": "test_training",
    "row_card_extras": false,
    "row_card_test_names": ["test_metric"]
  },
  "viewer": {
    "interactivity": {
      "enabled": false
    }
  },
  "cards": [
    {"type": "run_card", "id": "run-card", "title": "Run card", "bind": "run_card_display"},
    {"type": "lifecycle_timeline", "id": "lifecycle", "title": "Lifecycle timeline", "bind": "lifecycle"},
    {"type": "sweep_analytics", "id": "sweep", "title": "Sweep analytics", "bind": "datasets.training_sweep"},
    {"type": "gate_matrix", "id": "gates", "title": "Gate matrix", "bind": "gate_matrix"},
    {"type": "gate_heatmap", "bind": "gate_matrix", "when_empty": "hide"},
    {"type": "sweep_cell_cards", "id": "cells", "title": "Sweep cells", "bind": "cells"},
    {"type": "table", "id": "results", "title": "Full results", "bind": "results_table"}
  ]
}
