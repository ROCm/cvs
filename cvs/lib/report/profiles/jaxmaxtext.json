{
  "schema_version": 1,
  "profile_id": "jaxmaxtext_rundeck",
  "suite_id": "jaxmaxtext",
  "report_basename": "jaxmaxtext_run_deck",
  "title": "JAX MaxText Run Deck",
  "subtitle": "JAX MaxText · single-node & distributed training summary",
  "footer": "CVS jaxmaxtext · render-only · does not affect gates",
  "link_name": "JAX MaxText Run Deck",
  "dataset_builder": "training_sweep",
  "interactive_viewer": true,
  "sources": {
    "results": "train_res_dict",
    "variant": "variant_config",
    "lifecycle": "lifecycle"
  },
  "hooks": {
    "tier_metric_specs": "cvs.lib.training.jaxmaxtext.utils.maxtext_parsing:tier_metric_specs",
    "metric_units": "cvs.lib.training.jaxmaxtext.utils.maxtext_parsing:TRAINING_METRIC_UNITS",
    "cell_dimensions": "cvs.lib.training.jaxmaxtext.utils.rundeck_adapter:jax_cell_dimensions",
    "run_card_display": "cvs.lib.report.profiles.hooks.jaxmaxtext_run_card:jaxmaxtext_run_card_display"
  },
  "sweep": {
    "metric_prefix": "training.",
    "throughput_metric": "training.tflops_per_sec_per_gpu",
    "headline_metric": "training.tflops_per_sec_per_gpu",
    "series_label": "JAX MaxText sweep",
    "tier_order": ["throughput", "convergence", "stability", "record"],
    "dimension_fields": [
      ["bs", "BS", "BS="],
      ["sl", "SL", "SL="],
      ["precision", "Precision", ""]
    ],
    "results_table_columns": [
      ["Model", null],
      ["GPU", null],
      ["BS", null],
      ["SL", null],
      ["Precision", null],
      ["TFLOP/s/GPU", "training.tflops_per_sec_per_gpu"],
      ["Tok/s/GPU", "training.tokens_per_sec_per_gpu"],
      ["Tok/s total", "training.tokens_per_sec_total"],
      ["P50 step (ms)", "training.step_time_p50_ms"],
      ["P95 step (ms)", "training.step_time_p95_ms"],
      ["Final loss", "training.final_loss"],
      ["Scaling eff. (%)", "training.scaling_efficiency_pct"]
    ],
    "cell_highlights": [
      ["tflops_per_sec_per_gpu", "TFLOP/s/GPU"],
      ["tokens_per_sec_per_gpu", "Tok/s/GPU"],
      ["final_loss", "Final loss"],
      ["step_time_p50_ms", "P50 step (ms)"],
      ["scaling_efficiency_pct", "Scaling eff. (%)"]
    ],
    "chart_series": [
      {"metric_suffix": "tflops_per_sec_per_gpu", "title": "TFLOP/s/GPU", "unit": "TFLOP/s/GPU", "invert": false},
      {"metric_suffix": "tokens_per_sec_per_gpu", "title": "Tokens/s/GPU", "unit": "tok/s/GPU", "invert": false},
      {"metric_suffix": "step_time_p50_ms", "title": "P50 step time", "unit": "ms", "invert": true},
      {"metric_suffix": "step_time_p95_ms", "title": "P95 step time", "unit": "ms", "invert": true},
      {"metric_suffix": "final_loss", "title": "Final loss", "unit": "loss", "invert": true},
      {"metric_suffix": "scaling_efficiency_pct", "title": "Scaling efficiency", "unit": "%", "invert": false}
    ]
  },
  "lifecycle": {
    "session_labels": [
      "container_launch",
      "rdma_setup",
      "tokenizer_setup",
      "smoke",
      "training",
      "checkpoint_resume",
      "teardown"
    ],
    "cell_labels": ["training"],
    "expand_labels": ["training"]
  },
  "behavior": {
    "inference_test_substring": "test_training",
    "row_card_extras": false,
    "row_card_test_names": ["test_metric"]
  },
  "viewer": {
    "group_by": ["precision"],
    "filters": ["bs", "sl", "precision"],
    "concurrency_field": "precision",
    "heatmap_row_fields": ["bs", "sl"],
    "comparison_hint": "Compare batch size / sequence length at each precision",
    "sweep_charts": { "enabled": false },
    "interactivity": { "enabled": false }
  },
  "cards": [
    {"type": "run_card", "id": "run-card", "title": "Run card", "bind": "run_card_display"},
    {"type": "lifecycle_timeline", "id": "lifecycle", "title": "Lifecycle timeline", "bind": "lifecycle"},
    {"type": "sweep_analytics", "id": "sweep", "title": "Sweep analytics", "bind": "datasets.training_sweep"},
    {"type": "gate_matrix", "id": "gates", "title": "Gate matrix", "bind": "gate_matrix"},
    {"type": "gate_heatmap", "bind": "gate_matrix", "when_empty": "hide"},
    {"type": "sweep_cell_cards", "id": "cells", "title": "Sweep cells", "bind": "cells"},
    {"type": "table", "id": "results", "title": "Full results", "bind": "results_table"}
  ]
}
