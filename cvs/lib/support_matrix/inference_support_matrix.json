  "_comment": "CVS inference HW/SW support matrix. One file for all inference frameworks. Deny-list semantics: an entry lists only what is UNSUPPORTED; anything not listed (including future GPU archs) is allowed. Enforcement is controlled by the CVS_SUPPORT_MATRIX_GATE environment variable (see README.md). Model templates are empty for their owners to fill from the DTNI tracker.",
  "_comment_model_entry_example": {
    "aliases": [
      "<optional alternate names or HF ids, e.g. meta-llama/Llama-3.1-8B>"
    ],
    "unsupported_gpu_arch": [
      "<archs where the model does not run at all, e.g. mi300x; empty [] = all archs allowed>"
    ],
    "required_rocm_min_version": "<minimum ROCm, e.g. 7.14.0; empty string for no minimum>",
    "required_rocm_max_version": "<maximum ROCm, set to gate a deprecated model; empty string for no maximum>",
    "unsupported_params": {
      "precision": {
        "mxfp4": [
          "<archs where precision=mxfp4 is unsupported, e.g. mi300x, mi325x>"
        ]
      }
    },
    "notes": "<optional free text; ignored by the gate>"
  },
