#
# CVS pre-push gate. Two BLOCKING checks (exit 1) before any push reaches
# GitHub:
#   1. Security scan of every commit being pushed -- internal AMD endpoints,
#      real cluster hostnames, exposed https ports, committed secrets/tokens.
#   2. The full unit-test suite against the working tree -- the same suite CI
#      runs via `make test`.
#
# The suite imports cvs from the source tree; the venv only supplies
# dependencies. Interpreter preference:
#   1. .test_venv  (created by `make test-venv` / `make installtest`)
#   2. .cvs_venv   (created by `make install`)
#   3. python3 / python on PATH (deps must already be importable)
#
# Bypass with `git push --no-verify` (checks still run in CI).

ZERO="0000000000000000000000000000000000000000"

# Git passes the destination remote name (or URL) as the hook's first argument.
REMOTE_NAME="$1"

if [ -x ".test_venv/bin/python" ]; then
    PY=".test_venv/bin/python"
elif [ -x ".cvs_venv/bin/python" ]; then
    PY=".cvs_venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    echo "" >&2
    echo "pre-push: ERROR: no python interpreter found." >&2
    echo "pre-push: run 'make test-venv installtest' to create .test_venv, then retry." >&2
    echo "pre-push: or bypass with 'git push --no-verify'." >&2
    echo "" >&2
    exit 1
fi

# Security scan: scan every commit this push adds. Git feeds
# "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. We
# enumerate the new commits with rev-list, then scan each commit's own diff.
# Scanning per-commit -- rather than the net range diff -- also catches a secret
# that one commit adds and a later commit removes, since the history still
# carries it.
#
# For a new branch (remote sha all-zero) we bound the walk to commits not
# already on the DESTINATION remote only (`--not --remotes=<name>`), not every
# remote: a branch already tracked on a private remote must still be scanned
# when it is published to a public one. If the destination has no tracking refs
# yet, the walk falls back to the branch's full reachable history.
#
# Fail closed: if rev-list or git show cannot read history/a diff (non-zero
# exit), block the push rather than letting an unscanned commit through.
scan_rc=0
echo "pre-push: scanning pushed commits for infra/secret leaks ..."
while read -r _local_ref local_sha _remote_ref remote_sha ; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue  # branch deletion
    if [ "$remote_sha" = "$ZERO" ]; then
        if [ -n "$REMOTE_NAME" ]; then
            commits="$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAME")"
        else
            commits="$(git rev-list "$local_sha")"
        fi
    else
        commits="$(git rev-list "$remote_sha..$local_sha")"
    fi
    if [ "$?" -ne 0 ]; then
        echo "" >&2
        echo "pre-push: ERROR: could not enumerate commits for $local_sha." >&2
        scan_rc=1
        continue
    fi
    for sha in $commits ; do
        commit_diff="$(git show --unified=0 --format= "$sha")"
        if [ "$?" -ne 0 ]; then
            echo "" >&2
            echo "pre-push: ERROR: could not read diff for commit $sha." >&2
            scan_rc=1
            continue
        fi
        [ -z "$commit_diff" ] && continue
        printf '%s\n' "$commit_diff" | "$PY" build_tools/security_scan.py --stdin || scan_rc=1
    done
done

if [ "$scan_rc" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: ERROR: security scan found leaks -- push aborted." >&2
    echo "pre-push: scrub the values above, or bypass with 'git push --no-verify'." >&2
    echo "" >&2
    exit 1
fi

echo "pre-push: running unit tests ($PY run_all_unittests.py) ..."
if ! "$PY" run_all_unittests.py ; then
    echo "" >&2
    echo "pre-push: ERROR: unit tests failed -- push aborted." >&2
    echo "pre-push: fix the failures above, or bypass with 'git push --no-verify'." >&2
    echo "" >&2
    exit 1
fi

echo "pre-push: unit tests passed."
exit 0
